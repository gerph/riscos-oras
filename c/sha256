/*************************************************** Gerph *********
 Function:      sha256_transform
 Description:   Process one 64-byte block, updating the running hash state
 Parameters:    context-> the context whose block is to be processed
 Returns:       none
 ******************************************************************/
static void sha256_transform(sha256_context_t *context)
{
    uint32_t schedule[64];
    uint32_t a, b, c, d, e, f, g, h;
    uint32_t t1, t2;
    int i;

    /* Message schedule words are big-endian, regardless of host byte order */
    for (i = 0; i < 16; ++i)
    {
        schedule[i] = ((uint32_t)context->block[i * 4] << 24) |
                      ((uint32_t)context->block[i * 4 + 1] << 16) |
                      ((uint32_t)context->block[i * 4 + 2] << 8) |
                      (uint32_t)context->block[i * 4 + 3];
    }
    for (i = 16; i < 64; ++i)
    {
        schedule[i] = SSIG1(schedule[i - 2]) + schedule[i - 7] +
                      SSIG0(schedule[i - 15]) + schedule[i - 16];
    }

    a = context->state[0];
    b = context->state[1];
    c = context->state[2];
    d = context->state[3];
    e = context->state[4];
    f = context->state[5];
    g = context->state[6];
    h = context->state[7];

    for (i = 0; i < 64; ++i)
    {
        t1 = h + BSIG1(e) + CH(e, f, g) + sha256_constants[i] + schedule[i];
        t2 = BSIG0(a) + MAJ(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    context->state[0] += a;
    context->state[1] += b;
    context->state[2] += c;
    context->state[3] += d;
    context->state[4] += e;
    context->state[5] += f;
    context->state[6] += g;
    context->state[7] += h;
}

void sha256_init(sha256_context_t *context)
{
    context->state[0] = 0x6a09e667U;
    context->state[1] = 0xbb67ae85U;
    context->state[2] = 0x3c6ef372U;
    context->state[3] = 0xa54ff53aU;
    context->state[4] = 0x510e527fU;
    context->state[5] = 0x9b05688cU;
    context->state[6] = 0x1f83d9abU;
    context->state[7] = 0x5be0cd19U;
    context->bit_count_hi = 0;
    context->bit_count_lo = 0;
    context->block_used = 0;
}

void sha256_update(sha256_context_t *context,
                   const unsigned char *data,
                   size_t length)
{
    size_t used;

    {
        uint32_t add_lo;
        uint32_t old_lo;

        /* 64-bit bit-count is tracked as two 32-bit halves; detect overflow
           of the low half (wrap below its previous value) to carry into
           the high half, and fold in bits shifted out of "length << 3" */
        add_lo = (uint32_t)(length << 3);
        old_lo = context->bit_count_lo;
        context->bit_count_lo += add_lo;
        if (context->bit_count_lo < old_lo)
        {
            context->bit_count_hi += 1;
        }
        context->bit_count_hi += (uint32_t)(length >> 29);
    }
    while (length != 0)
    {
        used = 64 - context->block_used;
        if (used > length)
        {
            used = length;
        }
        memcpy(context->block + context->block_used, data, used);
        context->block_used += used;
        data += used;
        length -= used;
        if (context->block_used == 64)
        {
            sha256_transform(context);
            context->block_used = 0;
        }
    }
}

void sha256_final(sha256_context_t *context, unsigned char digest[32])
{
    int i;

    /* Append the mandatory single '1' bit (as byte 0x80), then zero-pad.
       If there isn't room left in this block for the 8-byte length, pad
       to a full block, transform it, and continue padding into the next
       block before the length is appended */
    context->block[context->block_used++] = 0x80;
    if (context->block_used > 56)
    {
        while (context->block_used < 64)
        {
            context->block[context->block_used++] = 0;
        }
        sha256_transform(context);
        context->block_used = 0;
    }
    while (context->block_used < 56)
    {
        context->block[context->block_used++] = 0;
    }
    /* Length is appended as a big-endian 64-bit bit-count */
    context->block[context->block_used++] = (unsigned char)(context->bit_count_hi >> 24);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_hi >> 16);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_hi >> 8);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_hi);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_lo >> 24);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_lo >> 16);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_lo >> 8);
    context->block[context->block_used++] = (unsigned char)(context->bit_count_lo);
    sha256_transform(context);
    for (i = 0; i < 8; ++i)
    {
        digest[i * 4] = (unsigned char)(context->state[i] >> 24);
        digest[i * 4 + 1] = (unsigned char)(context->state[i] >> 16);
        digest[i * 4 + 2] = (unsigned char)(context->state[i] >> 8);
        digest[i * 4 + 3] = (unsigned char)context->state[i];
    }
}

void sha256_to_hex(const unsigned char digest[32], char output[65])
{
    static const char hex[] = "0123456789abcdef";
    int i;

    for (i = 0; i < 32; ++i)
    {
        output[i * 2] = hex[digest[i] >> 4];
        output[i * 2 + 1] = hex[digest[i] & 0x0f];
    }
    output[64] = '\0';
}
