/*******************************************************************
 * File:        main
 * Purpose:     oras command line tool
 * Author:      Gerph
 ******************************************************************/

#include <stdlib.h>
#include <stdio.h>
#include <string.h>

#include "cJSON/cJSON.h"

#include "oras_types.h"
#include "oci_manifest.h"
#include "oci_registry.h"
#include "oci_auth.h"
#include "riscos_fileset.h"
#include "sha256.h"
#include "selftest.h"
#include "os.h"

#include "VersionNum"

/*************************************************** Gerph *********
 Function:      write_output
 Description:   Write data to a file, or to stdout if no path given
 Parameters:    data-> the bytes to write
                size = number of bytes to write
                path-> destination filename, or NULL for stdout
                append_newline = append a newline when writing to stdout
 Returns:       none (exits the process on failure to open the file)
 ******************************************************************/
static void write_output(const unsigned char *data,
                         size_t size,
                         const char *path,
                         int append_newline)
{
    FILE *fp;

    if (path == NULL)
    {
        fwrite(data, 1, size, stdout);
        if (append_newline && (size == 0 || data[size - 1] != '\n'))
        {
            fputc('\n', stdout);
        }
        return;
    }
    fp = fopen(path, "wb");
    if (fp == NULL)
    {
        fprintf(stderr, "Unable to open '%s' for writing\n", path);
        exit(EXIT_FAILURE);
    }
    if (size != 0)
    {
        fwrite(data, 1, size, fp);
    }
    fclose(fp);
}

/*************************************************** Gerph *********
 Function:      format_json
 Description:   Format a JSON document for human-readable output
 Parameters:    json-> JSON document to format
                error-> buffer for error message
                error_size = size of the error buffer
 Returns:       allocated formatted JSON, or NULL on failure
 ******************************************************************/
static char *format_json(const char *json, char *error, size_t error_size)
{
    cJSON *root;
    char *formatted;

    root = cJSON_Parse(json);
    if (root == NULL)
    {
        oras_set_error(error, error_size, "Registry returned malformed manifest JSON");
        return NULL;
    }
    formatted = cJSON_Print(root);
    cJSON_Delete(root);
    if (formatted == NULL)
    {
        oras_set_error(error, error_size, "No memory for formatted manifest JSON");
    }
    return formatted;
}

/*************************************************** Gerph *********
 Function:      pull_fetch_blob
 Description:   Blob fetcher callback used to satisfy riscos_fileset_extract
                by fetching a blob from the registry named by the reference
 Parameters:    private_ref-> the oci_reference_t of the source registry
                descriptor-> descriptor of the blob to fetch
                data_out-> where to store the allocated blob data
                size_out-> where to store the blob size
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 if fetched ok, 0 on failure
 ******************************************************************/
static int pull_fetch_blob(void *private_ref,
                           const oci_descriptor_t *descriptor,
                           unsigned char **data_out,
                           size_t *size_out,
                           char *error,
                           size_t error_size)
{
    const oci_reference_t *reference;

    reference = (const oci_reference_t *)private_ref;
    return oci_registry_fetch_blob(reference,
                                   descriptor->digest,
                                   data_out,
                                   size_out,
                                   error,
                                   error_size);
}

/*************************************************** Gerph *********
 Function:      print_usage
 Description:   Print the command syntax summary to stdout
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void print_usage(void)
{
    printf("oras " Module_FullVersionAndDate "\n");
    printf("Syntax:\n");
    printf("  *oras pull <reference> [<directory>]\n");
    printf("  *oras push [--source <uri|github:owner/repository>] <reference> <path>...\n");
    printf("  *oras manifest fetch [--pretty] <reference> [<file>]\n");
    printf("  *oras manifest fetch-config <reference> [<file>]\n");
    printf("  *oras manifest push <reference> <file>\n");
    printf("  *oras blob fetch <reference> <digest> [<file>]\n");
    printf("  *oras tags <repository>\n");
    printf("  *oras tag <reference> <tag>...\n");
    printf("  *oras attach <reference> <path>...\n");
    printf("  *oras discover <reference>\n");
    printf("  *oras login <registry> <username>\n");
    printf("  *oras logout <registry>\n");
    printf("  *oras --self-test\n");
}

/*************************************************** Gerph *********
 Function:      skip_space
 Description:   Skip past leading whitespace in a string
 Parameters:    text-> the string to scan
 Returns:       pointer to the first non-whitespace character
 ******************************************************************/
static const char *skip_space(const char *text)
{
    while (*text == ' ' || *text == '\t' || *text == '\r' || *text == '\n')
    {
        ++text;
    }
    return text;
}

/*************************************************** Gerph *********
 Function:      find_tags_array
 Description:   Locate the opening of the "tags" JSON array within a tags
                listing response
 Parameters:    json-> the JSON text to search
 Returns:       pointer to the character after the array's opening '[',
                or NULL if no "tags" array was found
 ******************************************************************/
static const char *find_tags_array(const char *json)
{
    const char *scan;

    scan = json;
    while ((scan = strstr(scan, "\"tags\"")) != NULL)
    {
        scan += 6;
        scan = skip_space(scan);
        if (*scan != ':')
        {
            continue;
        }
        ++scan;
        scan = skip_space(scan);
        if (*scan == '[')
        {
            return scan + 1;
        }
    }
    return NULL;
}

/*************************************************** Gerph *********
 Function:      print_tags_fast
 Description:   Print each tag string in a tags listing response without
                performing a full JSON parse; used as a lightweight path
                for the common case of a simple flat "tags" array
 Parameters:    json-> the JSON text to scan
 Returns:       1 if the array was printed successfully, 0 if the text
                did not match the expected simple form (caller should
                fall back to printing the raw JSON)
 ******************************************************************/
static int print_tags_fast(const char *json)
{
    const char *scan;
    const char *start;
    int done;

    scan = find_tags_array(json);
    if (scan == NULL)
    {
        return 0;
    }

    done = 0;
    for (;;)
    {
        scan = skip_space(scan);
        if (*scan == ']')
        {
            return 1;
        }
        if (*scan != '"')
        {
            return 0;
        }
        ++scan;
        start = scan;
        while (*scan != '\0')
        {
            if (*scan == '\\' && scan[1] != '\0')
            {
                scan += 2;
                continue;
            }
            if (*scan == '"')
            {
                fwrite(start, 1, (size_t)(scan - start), stdout);
                putchar('\n');
                ++scan;
                scan = skip_space(scan);
                if (*scan == ',')
                {
                    ++scan;
                    done = 1;
                    break;
                }
                if (*scan == ']')
                {
                    return 1;
                }
                return 0;
            }
            ++scan;
        }
        if (done)
        {
            done = 0;
            continue;
        }
        return 0;
    }
}

/*************************************************** Gerph *********
 Function:      print_tags
 Description:   Print the tags from a tags listing response, falling back
                to printing the raw JSON if the fast-path scan fails
 Parameters:    json-> the JSON text to print
 Returns:       none
 ******************************************************************/
static void print_tags(const char *json)
{
    if (!print_tags_fast(json))
    {
        printf("%s\n", json);
    }
}

/*************************************************** Gerph *********
 Function:      is_valid_tag
 Description:   Check that a command tag has the OCI tag character form
 Parameters:    tag-> tag text to validate
 Returns:       1 if valid, 0 otherwise
 ******************************************************************/
static int is_valid_tag(const char *tag)
{
    size_t length;
    const char *scan;

    length = strlen(tag);
    if (length == 0 || length > 128)
    {
        return 0;
    }
    if (!((tag[0] >= 'a' && tag[0] <= 'z') ||
          (tag[0] >= 'A' && tag[0] <= 'Z') ||
          (tag[0] >= '0' && tag[0] <= '9') || tag[0] == '_'))
    {
        return 0;
    }
    for (scan = tag; *scan != '\0'; ++scan)
    {
        if (!((*scan >= 'a' && *scan <= 'z') ||
               (*scan >= 'A' && *scan <= 'Z') ||
               (*scan >= '0' && *scan <= '9') ||
               *scan == '_' || *scan == '.' || *scan == '-'))
        {
            return 0;
        }
    }
    return 1;
}

static char *manifest_digest(const char *json)
{
    sha256_context_t context;
    unsigned char digest[32];
    char hex[65];
    char *result;

    sha256_init(&context);
    sha256_update(&context, (const unsigned char *)json, strlen(json));
    sha256_final(&context, digest);
    sha256_to_hex(digest, hex);
    result = malloc(strlen("sha256:") + strlen(hex) + 1);
    if (result != NULL)
    {
        sprintf(result, "sha256:%s", hex);
    }
    return result;
}

static char *referrers_tag(const char *digest)
{
    char *tag;

    if (strncmp(digest, "sha256:", 7) != 0)
    {
        return NULL;
    }
    tag = malloc(strlen(digest) + strlen(".referrers") + 1);
    if (tag != NULL)
    {
        sprintf(tag, "sha256-%s.referrers", digest + 7);
    }
    return tag;
}

/*************************************************** Gerph *********
 Function:      read_text_file
 Description:   Read a complete text file into an allocated buffer
 Parameters:    path-> file to read
                text_out-> receives the allocated NUL-terminated text
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 on success, 0 on failure
 ******************************************************************/
static int read_text_file(const char *path,
                          char **text_out,
                          char *error,
                          size_t error_size)
{
    FILE *fp;
    long length;
    char *text;

    fp = fopen(path, "rb");
    if (fp == NULL || fseek(fp, 0, SEEK_END) != 0 ||
        (length = ftell(fp)) < 0 || fseek(fp, 0, SEEK_SET) != 0)
    {
        if (fp != NULL)
        {
            fclose(fp);
        }
        oras_set_error(error, error_size, "Unable to read '%s'", path);
        return 0;
    }
    text = malloc((size_t)length + 1);
    if (text == NULL || fread(text, 1, (size_t)length, fp) != (size_t)length)
    {
        fclose(fp);
        free(text);
        oras_set_error(error, error_size, "Unable to read '%s'", path);
        return 0;
    }
    fclose(fp);
    text[length] = '\0';
    *text_out = text;
    return 1;
}

/*************************************************** Gerph *********
 Function:      source_uri_from_option
 Description:   Expand a source option, including the GitHub shorthand
 Parameters:    option-> source URI or github:owner/repository shorthand
                source_uri_out-> allocated URI result
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 on success, 0 on invalid input or allocation failure
 ******************************************************************/
static int source_uri_from_option(const char *option,
                                  char **source_uri_out,
                                  char *error,
                                  size_t error_size)
{
    const char *github_prefix;
    const char *repository;

    github_prefix = "github:";
    *source_uri_out = NULL;
    if (option[0] == '\0')
    {
        oras_set_error(error, error_size, "Source URI must not be empty");
        return 0;
    }
    if (strncmp(option, github_prefix, strlen(github_prefix)) == 0)
    {
        repository = option + strlen(github_prefix);
        if (repository[0] == '\0' || strchr(repository, '/') == NULL)
        {
            oras_set_error(error, error_size,
                           "GitHub source must be github:<owner>/<repository>");
            return 0;
        }
        *source_uri_out = malloc(strlen("https://github.com/") + strlen(repository) + 1);
        if (*source_uri_out != NULL)
        {
            sprintf(*source_uri_out, "https://github.com/%s", repository);
        }
    }
    else
    {
        *source_uri_out = oras_strdup(option);
    }
    if (*source_uri_out == NULL)
    {
        oras_set_error(error, error_size, "No memory for source URI");
        return 0;
    }
    return 1;
}

/*************************************************** Gerph *********
 Function:      main
 Description:   Entry point for the oras command line tool; dispatches to
                the pull/push/manifest/blob/tags/tag/attach/discover and
                self-test operations
                according to the command line arguments
 Parameters:    argc = number of command line arguments
                argv-> array of argument strings
 Returns:       does not return; exits with EXIT_SUCCESS or EXIT_FAILURE
 ******************************************************************/
int main(int argc, char *argv[])
{
    char error[256];

    if (argc == 2 && strcmp(argv[1], "--self-test") == 0)
    {
        return oras_run_self_tests();
    }
    if (argc < 2)
    {
        print_usage();
        exit(EXIT_FAILURE);
    }
    if (strcmp(argv[1], "login") == 0 && argc == 4)
    {
        char secret[256];
        _kernel_oserror *oserror;

        printf("Secret for %s at %s: ", argv[3], argv[2]);
        fflush(stdout);
        oserror = os_readline_secret(secret, sizeof(secret));
        if (oserror != NULL || !oci_auth_login(argv[2], argv[3], secret, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", oserror != NULL ? oserror->errmess : error);
            exit(EXIT_FAILURE);
        }
        printf("Login stored for %s\n", argv[2]);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "logout") == 0 && argc == 3)
    {
        if (!oci_auth_logout(argv[2], error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        printf("Login removed for %s\n", argv[2]);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "manifest") == 0 && argc >= 4 && strcmp(argv[2], "fetch") == 0)
    {
        oci_reference_t reference;
        char *json;
        const char *reference_text;
        const char *output_path;
        int pretty;

        pretty = strcmp(argv[3], "--pretty") == 0;
        if (pretty && argc < 5)
        {
            print_usage();
            exit(EXIT_FAILURE);
        }
        reference_text = pretty ? argv[4] : argv[3];
        output_path = pretty ? (argc >= 6 ? argv[5] : NULL) :
                               (argc >= 5 ? argv[4] : NULL);
        if (!oci_parse_reference(reference_text, &reference, error, sizeof(error)) ||
            !oci_registry_fetch_manifest(&reference, &json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        if (pretty)
        {
            char *formatted;

            formatted = format_json(json, error, sizeof(error));
            free(json);
            if (formatted == NULL)
            {
                fprintf(stderr, "%s\n", error);
                oras_free_reference(&reference);
                exit(EXIT_FAILURE);
            }
            json = formatted;
        }
        write_output((const unsigned char *)json,
                     strlen(json),
                     output_path,
                     1);
        free(json);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "manifest") == 0 && argc >= 4 &&
        strcmp(argv[2], "fetch-config") == 0)
    {
        oci_reference_t reference;
        oci_manifest_t manifest;
        char *json;
        unsigned char *data;
        size_t size;

        if (!oci_parse_reference(argv[3], &reference, error, sizeof(error)) ||
            !oci_registry_fetch_manifest(&reference, &json, error, sizeof(error)) ||
            !oci_manifest_parse(json, &manifest, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        free(json);
        if (!manifest.has_config || manifest.config.digest == NULL ||
            manifest.config.digest[0] == '\0')
        {
            fprintf(stderr, "Manifest has no config descriptor\n");
            oras_free_manifest(&manifest);
            oras_free_reference(&reference);
            exit(EXIT_FAILURE);
        }
        if (!oci_registry_fetch_blob(&reference,
                                     manifest.config.digest,
                                     &data,
                                     &size,
                                     error,
                                     sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            oras_free_manifest(&manifest);
            oras_free_reference(&reference);
            exit(EXIT_FAILURE);
        }
        write_output(data, size, argc >= 5 ? argv[4] : NULL, 0);
        free(data);
        oras_free_manifest(&manifest);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "manifest") == 0 && argc == 5 &&
        strcmp(argv[2], "push") == 0)
    {
        oci_reference_t reference;
        oci_manifest_t manifest;
        char *json;

        if (!oci_parse_reference(argv[3], &reference, error, sizeof(error)) ||
            !read_text_file(argv[4], &json, error, sizeof(error)) ||
            !oci_manifest_parse(json, &manifest, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        if (manifest.media_type == NULL)
        {
            fprintf(stderr, "Manifest JSON has no mediaType\n");
            free(json);
            oras_free_manifest(&manifest);
            oras_free_reference(&reference);
            exit(EXIT_FAILURE);
        }
        if (!oci_registry_push_manifest_as(&reference,
                                           json,
                                           manifest.media_type,
                                           error,
                                           sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            free(json);
            oras_free_manifest(&manifest);
            oras_free_reference(&reference);
            exit(EXIT_FAILURE);
        }
        printf("Manifest pushed to %s/%s\n", reference.registry, reference.repository);
        free(json);
        oras_free_manifest(&manifest);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "blob") == 0 && argc >= 5 && strcmp(argv[2], "fetch") == 0)
    {
        oci_reference_t reference;
        unsigned char *data;
        size_t size;

        if (!oci_parse_reference(argv[3], &reference, error, sizeof(error)) ||
            !oci_registry_fetch_blob(&reference, argv[4], &data, &size, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        write_output(data, size, argc >= 6 ? argv[5] : NULL, 0);
        free(data);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "tags") == 0 && argc >= 3)
    {
        oci_reference_t reference;
        char *json;

        if (!oci_parse_reference(argv[2], &reference, error, sizeof(error)) ||
            !oci_registry_list_tags(&reference, &json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        print_tags(json);
        free(json);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "tag") == 0 && argc >= 4)
    {
        oci_reference_t reference;
        int i;

        if (!oci_parse_reference(argv[2], &reference, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        for (i = 3; i < argc; ++i)
        {
            if (!is_valid_tag(argv[i]))
            {
                fprintf(stderr, "Invalid OCI tag '%s'\n", argv[i]);
                oras_free_reference(&reference);
                exit(EXIT_FAILURE);
            }
            if (!oci_registry_tag_manifest(&reference, argv[i], error, sizeof(error)))
            {
                fprintf(stderr, "%s\n", error);
                oras_free_reference(&reference);
                exit(EXIT_FAILURE);
            }
            printf("Tagged %s/%s as %s\n",
                   reference.registry, reference.repository, argv[i]);
        }
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "attach") == 0 && argc >= 4)
    {
        oci_reference_t reference;
        oci_reference_t attach_reference;
        oci_reference_t index_reference;
        riscos_fileset_entry_t *entries;
        size_t entry_count;
        oci_manifest_t subject_manifest;
        oci_manifest_t attachment;
        oci_manifest_t index;
        char *subject_json;
        char *attachment_json;
        char *index_json;
        char *subject_digest;
        char *attachment_digest;
        char *tag;
        char *existing_index_json;
        size_t subject_size;
        int found;
        int i;

        memset(&attach_reference, 0, sizeof(attach_reference));
        memset(&index_reference, 0, sizeof(index_reference));
        if (!oci_parse_reference(argv[2], &reference, error, sizeof(error)) ||
            !oci_registry_fetch_manifest(&reference, &subject_json, error, sizeof(error)) ||
            !oci_manifest_parse(subject_json, &subject_manifest, error, sizeof(error)) ||
            !riscos_fileset_plan((const char *const *)&argv[3], (size_t)(argc - 3),
                                 &entries, &entry_count, error, sizeof(error)) ||
            !riscos_fileset_manifest_from_entries(entries, entry_count, NULL,
                                                  &attachment, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        subject_digest = manifest_digest(subject_json);
        subject_size = strlen(subject_json);
        free(subject_json);
        if (subject_digest == NULL)
        {
            fprintf(stderr, "No memory for subject digest\n");
            exit(EXIT_FAILURE);
        }
        attachment.has_subject = true;
        attachment.subject.media_type = oras_strdup(subject_manifest.media_type != NULL ?
                                                     subject_manifest.media_type : ORAS_MANIFEST_MEDIA_TYPE);
        attachment.subject.digest = oras_strdup(subject_digest);
        attachment.subject.size = subject_size;
        oras_free_manifest(&subject_manifest);
        if (attachment.subject.media_type == NULL || attachment.subject.digest == NULL ||
            !oci_manifest_write(&attachment, &attachment_json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        for (i = 0; i < (int)entry_count; ++i)
        {
            FILE *fp;
            unsigned char *data;
            size_t size;

            fp = fopen(entries[i].source_path, "rb");
            size = entries[i].descriptor.size;
            data = malloc(size == 0 ? 1 : size);
            if (fp == NULL || data == NULL || (size != 0 && fread(data, 1, size, fp) != size))
            {
                fprintf(stderr, "Unable to read '%s'\n", entries[i].source_path);
                exit(EXIT_FAILURE);
            }
            fclose(fp);
            if (!oci_registry_push_blob(&reference, data, size, entries[i].descriptor.digest,
                                        error, sizeof(error)))
            {
                fprintf(stderr, "%s\n", error);
                exit(EXIT_FAILURE);
            }
            free(data);
        }
        attachment_digest = manifest_digest(attachment_json);
        attach_reference.registry = oras_strdup(reference.registry);
        attach_reference.repository = oras_strdup(reference.repository);
        attach_reference.digest = attachment_digest;
        if (attach_reference.registry == NULL || attach_reference.repository == NULL ||
            !oci_registry_push_manifest(&attach_reference, attachment_json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        tag = referrers_tag(subject_digest);
        index_reference.registry = oras_strdup(reference.registry);
        index_reference.repository = oras_strdup(reference.repository);
        index_reference.tag = tag;
        existing_index_json = NULL;
        if (tag == NULL || index_reference.registry == NULL || index_reference.repository == NULL ||
            !oci_registry_fetch_manifest_optional(&index_reference, &existing_index_json, &found,
                                                  error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        memset(&index, 0, sizeof(index));
        if (found)
        {
            if (!oci_manifest_parse(existing_index_json, &index, error, sizeof(error)) ||
                index.media_type == NULL || strcmp(index.media_type, ORAS_INDEX_MEDIA_TYPE) != 0)
            {
                fprintf(stderr, "%s\n", index.media_type == NULL ? error : "Invalid referrers index");
                exit(EXIT_FAILURE);
            }
            free(existing_index_json);
        }
        else
        {
            index.schema_version = 2;
            index.media_type = oras_strdup(ORAS_INDEX_MEDIA_TYPE);
        }
        index.manifests = oras_reallocarray(index.manifests, index.manifest_count + 1,
                                             sizeof(*index.manifests));
        if (index.media_type == NULL || index.manifests == NULL)
        {
            fprintf(stderr, "No memory for referrers index\n");
            exit(EXIT_FAILURE);
        }
        memset(&index.manifests[index.manifest_count], 0, sizeof(*index.manifests));
        index.manifests[index.manifest_count].media_type = oras_strdup(ORAS_MANIFEST_MEDIA_TYPE);
        index.manifests[index.manifest_count].digest = oras_strdup(attachment_digest);
        index.manifests[index.manifest_count].size = strlen(attachment_json);
        index.manifest_count += 1;
        if (index.manifests[index.manifest_count - 1].media_type == NULL ||
            index.manifests[index.manifest_count - 1].digest == NULL ||
            !oci_manifest_write(&index, &index_json, error, sizeof(error)) ||
            !oci_registry_push_manifest_as(&index_reference, index_json,
                                           ORAS_INDEX_MEDIA_TYPE,
                                           error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        printf("Attached files to %s/%s\n", reference.registry, reference.repository);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "discover") == 0 && argc == 3)
    {
        oci_reference_t reference;
        oci_reference_t index_reference;
        char *subject_json;
        char *subject_digest;
        char *tag;
        char *index_json;
        oci_manifest_t index;
        int found;
        size_t i;

        memset(&index_reference, 0, sizeof(index_reference));
        if (!oci_parse_reference(argv[2], &reference, error, sizeof(error)) ||
            !oci_registry_fetch_manifest(&reference, &subject_json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        subject_digest = manifest_digest(subject_json);
        free(subject_json);
        tag = subject_digest == NULL ? NULL : referrers_tag(subject_digest);
        index_reference.registry = oras_strdup(reference.registry);
        index_reference.repository = oras_strdup(reference.repository);
        index_reference.tag = tag;
        index_json = NULL;
        if (subject_digest == NULL || tag == NULL || index_reference.registry == NULL ||
            index_reference.repository == NULL ||
            !oci_registry_fetch_manifest_optional(&index_reference, &index_json, &found,
                                                  error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        if (!found)
        {
            exit(EXIT_SUCCESS);
        }
        if (!oci_manifest_parse(index_json, &index, error, sizeof(error)) ||
            index.media_type == NULL || strcmp(index.media_type, ORAS_INDEX_MEDIA_TYPE) != 0)
        {
            fprintf(stderr, "%s\n", index.media_type == NULL ? error : "Invalid referrers index");
            exit(EXIT_FAILURE);
        }
        for (i = 0; i < index.manifest_count; ++i)
        {
            printf("%s %s %u\n", index.manifests[i].digest,
                   index.manifests[i].media_type,
                   (unsigned int)index.manifests[i].size);
        }
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "pull") == 0 && argc >= 3)
    {
        oci_reference_t reference;
        char *json;
        oci_manifest_t manifest;
        const char *directory;

        directory = argc >= 4 ? argv[3] : "@";
        if (!oci_parse_reference(argv[2], &reference, error, sizeof(error)) ||
            !oci_registry_fetch_manifest(&reference, &json, error, sizeof(error)) ||
            !oci_manifest_parse(json, &manifest, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        free(json);
        if (manifest.manifest_count != 0)
        {
            oci_descriptor_t selected;
            oci_reference_t child_reference;
            char *selected_json;
            oci_manifest_t selected_manifest;

            if (!oci_manifest_select(&manifest, NULL, NULL, &selected, error, sizeof(error)))
            {
                fprintf(stderr, "%s\n", error);
                exit(EXIT_FAILURE);
            }
            memset(&child_reference, 0, sizeof(child_reference));
            child_reference.registry = oras_strdup(reference.registry);
            child_reference.repository = oras_strdup(reference.repository);
            child_reference.digest = oras_strdup(selected.digest);
            oras_free_descriptor(&selected);
            if (!oci_registry_fetch_manifest(&child_reference, &selected_json, error, sizeof(error)) ||
                !oci_manifest_parse(selected_json, &selected_manifest, error, sizeof(error)))
            {
                fprintf(stderr, "%s\n", error);
                exit(EXIT_FAILURE);
            }
            free(selected_json);
            oras_free_reference(&child_reference);
            oras_free_manifest(&manifest);
            manifest = selected_manifest;
        }
        if (!riscos_fileset_extract(&manifest,
                                    directory,
                                    pull_fetch_blob,
                                    &reference,
                                    error,
                                    sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        oras_free_manifest(&manifest);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }
    if (strcmp(argv[1], "push") == 0 && argc >= 4)
    {
        oci_reference_t reference;
        riscos_fileset_entry_t *entries;
        size_t entry_count;
        oci_manifest_t manifest;
        char *json;
        char *source_uri;
        int argument;
        int i;

        argument = 2;
        source_uri = NULL;
        if (strcmp(argv[argument], "--source") == 0)
        {
            if (argc < 6 || !source_uri_from_option(argv[argument + 1],
                                                     &source_uri,
                                                     error,
                                                     sizeof(error)))
            {
                fprintf(stderr, "%s\n", argc < 6 ? "Missing source, reference, or file" : error);
                exit(EXIT_FAILURE);
            }
            argument += 2;
        }
        if (argc < argument + 2 ||
            !oci_parse_reference(argv[argument], &reference, error, sizeof(error)) ||
            !riscos_fileset_plan((const char *const *)&argv[argument + 1],
                                 (size_t)(argc - argument - 1),
                                 &entries,
                                 &entry_count,
                                 error,
                                 sizeof(error)) ||
            !riscos_fileset_manifest_from_entries(entries,
                                                  entry_count,
                                                  source_uri,
                                                  &manifest,
                                                  error,
                                                  sizeof(error)) ||
            !oci_manifest_write(&manifest, &json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        free(source_uri);
        for (i = 0; i < (int)entry_count; ++i)
        {
            FILE *fp;
            unsigned char *data;
            size_t size;

            fp = fopen(entries[i].source_path, "rb");
            if (fp == NULL)
            {
                fprintf(stderr, "Unable to reopen '%s'\n", entries[i].source_path);
                exit(EXIT_FAILURE);
            }
            size = entries[i].descriptor.size;
            data = malloc(size == 0 ? 1 : size);
            if (data == NULL)
            {
                fprintf(stderr, "No memory for blob upload\n");
                exit(EXIT_FAILURE);
            }
            if (size != 0)
            {
                fread(data, 1, size, fp);
            }
            fclose(fp);
            if (!oci_registry_push_blob(&reference,
                                        data,
                                        size,
                                        entries[i].descriptor.digest,
                                        error,
                                        sizeof(error)))
            {
                fprintf(stderr, "%s\n", error);
                exit(EXIT_FAILURE);
            }
            free(data);
        }
        if (!oci_registry_push_manifest(&reference, json, error, sizeof(error)))
        {
            fprintf(stderr, "%s\n", error);
            exit(EXIT_FAILURE);
        }
        free(json);
        oras_free_manifest(&manifest);
        riscos_fileset_free_entries(entries, entry_count);
        oras_free_reference(&reference);
        exit(EXIT_SUCCESS);
    }

    print_usage();
    exit(EXIT_FAILURE);
}
