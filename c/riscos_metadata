#include <stdlib.h>
#include <string.h>
#include <stdio.h>

#include "oras_types.h"
#include "riscos_metadata.h"
#include "os.h"

#define RISCOS_TYPED_LOAD_PREFIX 0xFFF00000U

/*************************************************** Gerph *********
 Function:      parse_hex_field
 Description:   Parse a fixed-width hex field from an annotation value
 Parameters:    text-> the text to parse
                digits = the exact number of hex digits expected
                value_out-> where to store the parsed value
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 if successful, 0 if failed (error is filled in)
 ******************************************************************/
static int parse_hex_field(const char *text,
                           size_t digits,
                           uint32_t *value_out,
                           char *error,
                           size_t error_size)
{
    size_t i;
    uint32_t value;
    char ch;

    if (strlen(text) != digits)
    {
        oras_set_error(error, error_size, "Expected %u hex digits", (unsigned int)digits);
        return 0;
    }
    value = 0;
    for (i = 0; i < digits; ++i)
    {
        ch = text[i];
        value <<= 4;
        if (ch >= '0' && ch <= '9')
        {
            value |= (uint32_t)(ch - '0');
        }
        else if (ch >= 'A' && ch <= 'F')
        {
            value |= (uint32_t)(ch - 'A' + 10);
        }
        else if (ch >= 'a' && ch <= 'f')
        {
            value |= (uint32_t)(ch - 'a' + 10);
        }
        else
        {
            oras_set_error(error, error_size, "Invalid hex value '%s'", text);
            return 0;
        }
    }
    *value_out = value;
    return 1;
}

/*************************************************** Gerph *********
 Function:      metadata_from_filename
 Description:   Derive a filetype from a ",xyz" filename suffix
 Parameters:    path-> the filename to examine
                meta-> the metadata to update if a filetype is found
 Returns:       none
 ******************************************************************/
static void metadata_from_filename(const char *path, riscos_file_meta_t *meta)
{
    const char *comma;
    unsigned int value;

    comma = strrchr(path, ',');
    if (comma != NULL && strlen(comma + 1) == 3)
    {
        if (sscanf(comma + 1, "%x", &value) == 1)
        {
            /* RISC OS convention: a trailing ",xyz" suffix encodes the
               12-bit filetype in hex */
            meta->has_filetype = true;
            meta->filetype = value & 0xFFFU;
        }
    }
}

int riscos_metadata_read(const char *path,
                         riscos_file_meta_t *meta,
                         char *error,
                         size_t error_size)
{
    int object_type;
    uint32_t loadaddr;
    uint32_t execaddr;
    uint32_t attrs;

    memset(meta, 0, sizeof(*meta));
    if (!oras_os_file_info(path, &object_type, &loadaddr, &execaddr, &attrs))
    {
        metadata_from_filename(path, meta);
        if (!meta->has_filetype)
        {
            oras_set_error(error, error_size, "Unable to read metadata for '%s': %s",
                           path, "OS_File failed");
            return 0;
        }
        return 1;
    }
    meta->has_loadexec = true;
    meta->loadaddr = loadaddr;
    meta->execaddr = execaddr;
    meta->has_attrs = true;
    meta->attrs = attrs;
    if ((loadaddr & 0xFFF00000U) == RISCOS_TYPED_LOAD_PREFIX)
    {
        /* Top 12 bits of load address are 0xFFF for a "typed" file; the
           filetype itself is held in bits 8-19 */
        meta->has_filetype = true;
        meta->filetype = (loadaddr >> 8) & 0xFFFU;
    }
    else
    {
        metadata_from_filename(path, meta);
    }
    return 1;
}

int riscos_metadata_apply(const char *path,
                          const riscos_file_meta_t *meta,
                          char *error,
                          size_t error_size)
{
    if (meta->has_loadexec)
    {
        if (!oras_os_file_set_info(path, meta->loadaddr, meta->execaddr,
                                   meta->has_attrs ? meta->attrs : 0))
        {
            oras_set_error(error, error_size, "Unable to apply load/exec to '%s': %s",
                           path, "OS_File failed");
            return 0;
        }
    }
    else if (meta->has_filetype)
    {
        if (!oras_os_file_set_type(path, meta->filetype))
        {
            oras_set_error(error, error_size, "Unable to apply filetype to '%s': %s",
                           path, "OS_File failed");
            return 0;
        }
    }
    return 1;
}

int riscos_metadata_to_annotations(const riscos_file_meta_t *meta,
                                   oras_annotation_t **annotations,
                                   size_t *annotation_count,
                                   char *error,
                                   size_t error_size)
{
    char value[16];

    if (meta->has_filetype)
    {
        sprintf(value, "%03X", meta->filetype);
        if (!oras_set_annotation(annotations, annotation_count,
                                 ORAS_ANNOTATION_FILETYPE, value,
                                 error, error_size))
        {
            return 0;
        }
    }
    if (meta->has_loadexec)
    {
        sprintf(value, "%08X", meta->loadaddr);
        if (!oras_set_annotation(annotations, annotation_count,
                                 ORAS_ANNOTATION_LOADADDR, value,
                                 error, error_size))
        {
            return 0;
        }
        sprintf(value, "%08X", meta->execaddr);
        if (!oras_set_annotation(annotations, annotation_count,
                                 ORAS_ANNOTATION_EXECADDR, value,
                                 error, error_size))
        {
            return 0;
        }
    }
    if (meta->has_attrs)
    {
        sprintf(value, "0x%08X", meta->attrs);
        if (!oras_set_annotation(annotations, annotation_count,
                                 ORAS_ANNOTATION_ATTR, value,
                                 error, error_size))
        {
            return 0;
        }
    }
    return 1;
}

int riscos_metadata_from_annotations(const oras_annotation_t *annotations,
                                     size_t annotation_count,
                                     riscos_file_meta_t *meta,
                                     char *error,
                                     size_t error_size)
{
    const char *value;
    uint32_t parsed;

    memset(meta, 0, sizeof(*meta));
    value = oras_find_annotation(annotations, annotation_count, ORAS_ANNOTATION_FILETYPE);
    if (value != NULL)
    {
        if (!parse_hex_field(value, 3, &parsed, error, error_size))
        {
            return 0;
        }
        meta->has_filetype = true;
        meta->filetype = parsed & 0xFFFU;
    }
    value = oras_find_annotation(annotations, annotation_count, ORAS_ANNOTATION_LOADADDR);
    if (value != NULL)
    {
        if (!parse_hex_field(value, 8, &parsed, error, error_size))
        {
            return 0;
        }
        meta->has_loadexec = true;
        meta->loadaddr = parsed;
    }
    value = oras_find_annotation(annotations, annotation_count, ORAS_ANNOTATION_EXECADDR);
    if (value != NULL)
    {
        if (!parse_hex_field(value, 8, &parsed, error, error_size))
        {
            return 0;
        }
        meta->has_loadexec = true;
        meta->execaddr = parsed;
    }
    value = oras_find_annotation(annotations, annotation_count, ORAS_ANNOTATION_ATTR);
    if (value != NULL)
    {
        if (strncmp(value, "0x", 2) == 0 || strncmp(value, "0X", 2) == 0)
        {
            if (!parse_hex_field(value + 2, 8, &parsed, error, error_size))
            {
                return 0;
            }
        }
        else
        {
            parsed = (uint32_t)strtoul(value, NULL, 0);
        }
        meta->has_attrs = true;
        meta->attrs = parsed;
    }
    return 1;
}
