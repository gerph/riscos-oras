#include <stdlib.h>
#include <string.h>
#include <stdio.h>

#include "cJSON/cJSON.h"

#include "oras_types.h"
#include "oci_auth.h"

#define ORAS_AUTH_FILE "<ORASAuthentication$Write>"

static const char base64_chars[] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

char *oci_auth_base64_encode(const unsigned char *data, size_t size)
{
    char *output;
    size_t i;
    size_t out;

    output = malloc(((size + 2) / 3) * 4 + 1);
    if (output == NULL)
    {
        return NULL;
    }
    out = 0;
    for (i = 0; i < size; i += 3)
    {
        unsigned int value;
        size_t remaining;

        remaining = size - i;
        value = (unsigned int)data[i] << 16;
        if (remaining > 1) value |= (unsigned int)data[i + 1] << 8;
        if (remaining > 2) value |= data[i + 2];
        output[out++] = base64_chars[(value >> 18) & 63];
        output[out++] = base64_chars[(value >> 12) & 63];
        output[out++] = remaining > 1 ? base64_chars[(value >> 6) & 63] : '=';
        output[out++] = remaining > 2 ? base64_chars[value & 63] : '=';
    }
    output[out] = '\0';
    return output;
}

static int base64_value(int ch)
{
    const char *found;

    found = strchr(base64_chars, ch);
    return found == NULL ? -1 : (int)(found - base64_chars);
}

unsigned char *oci_auth_base64_decode(const char *text, size_t *size_out)
{
    unsigned char *output;
    size_t length;
    size_t i;
    size_t out;

    length = strlen(text);
    if (length == 0 || length % 4 != 0)
    {
        return NULL;
    }
    output = malloc(length / 4 * 3 + 1);
    if (output == NULL) return NULL;
    out = 0;
    for (i = 0; i < length; i += 4)
    {
        int a = base64_value((unsigned char)text[i]);
        int b = base64_value((unsigned char)text[i + 1]);
        int c = text[i + 2] == '=' ? 0 : base64_value((unsigned char)text[i + 2]);
        int d = text[i + 3] == '=' ? 0 : base64_value((unsigned char)text[i + 3]);
        unsigned int value;

        if (a < 0 || b < 0 || c < 0 || d < 0 ||
            (text[i + 2] == '=' && text[i + 3] != '=') ||
            ((text[i + 2] == '=' || text[i + 3] == '=') && i + 4 != length))
        {
            free(output);
            return NULL;
        }
        value = ((unsigned int)a << 18) | ((unsigned int)b << 12) |
                ((unsigned int)c << 6) | (unsigned int)d;
        output[out++] = (unsigned char)(value >> 16);
        if (text[i + 2] != '=') output[out++] = (unsigned char)(value >> 8);
        if (text[i + 3] != '=') output[out++] = (unsigned char)value;
    }
    output[out] = '\0';
    *size_out = out;
    return output;
}

static cJSON *read_config(int *missing_out, char *error, size_t error_size)
{
    FILE *fp;
    long length;
    char *text;
    cJSON *root;

    *missing_out = 0;
    text = NULL;
    fp = fopen(ORAS_AUTH_FILE, "rb");
    if (fp == NULL)
    {
        *missing_out = 1;
        oras_set_error(error, error_size,
                       "Credential file %s does not exist or cannot be read; run *oras login first",
                       ORAS_AUTH_FILE);
        return NULL;
    }
    fseek(fp, 0, SEEK_END);
    length = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    if (length < 0 || (text = malloc((size_t)length + 1)) == NULL ||
        fread(text, 1, (size_t)length, fp) != (size_t)length)
    {
        fclose(fp);
        free(text);
        oras_set_error(error, error_size, "Unable to read credential file %s", ORAS_AUTH_FILE);
        return NULL;
    }
    fclose(fp);
    text[length] = '\0';
    root = cJSON_Parse(text);
    free(text);
    if (!cJSON_IsObject(root))
    {
        cJSON_Delete(root);
        oras_set_error(error, error_size, "Credential file %s contains malformed JSON", ORAS_AUTH_FILE);
        return NULL;
    }
    return root;
}

static int write_config(cJSON *root, char *error, size_t error_size)
{
    char *text;
    FILE *fp;

    text = cJSON_PrintUnformatted(root);
    if (text == NULL)
    {
        oras_set_error(error, error_size, "No memory for credential file");
        return 0;
    }
    fp = fopen(ORAS_AUTH_FILE, "wb");
    if (fp == NULL)
    {
        free(text);
        oras_set_error(error, error_size, "Unable to write credential file %s", ORAS_AUTH_FILE);
        return 0;
    }
    if (fputs(text, fp) < 0 || fclose(fp) != 0)
    {
        free(text);
        oras_set_error(error, error_size, "Unable to write credential file %s", ORAS_AUTH_FILE);
        return 0;
    }
    free(text);
    return 1;
}

int oci_auth_get_credentials(const char *registry, char **username_out, char **secret_out,
                             char *error, size_t error_size)
{
    cJSON *root;
    cJSON *auths;
    cJSON *entry;
    cJSON *auth;
    unsigned char *decoded;
    size_t size;
    char *colon;

    *username_out = NULL;
    *secret_out = NULL;
    {
        int missing;
        root = read_config(&missing, error, error_size);
    }
    if (root == NULL) return 0;
    auths = cJSON_GetObjectItemCaseSensitive(root, "auths");
    entry = cJSON_IsObject(auths) ? cJSON_GetObjectItemCaseSensitive(auths, registry) : NULL;
    auth = cJSON_IsObject(entry) ? cJSON_GetObjectItemCaseSensitive(entry, "auth") : NULL;
    if (!cJSON_IsString(auth))
    {
        cJSON_Delete(root);
        oras_set_error(error, error_size, "No credential entry for registry '%s'", registry);
        return 0;
    }
    decoded = oci_auth_base64_decode(auth->valuestring, &size);
    cJSON_Delete(root);
    if (decoded == NULL || memchr(decoded, ':', size) == NULL)
    {
        free(decoded);
        oras_set_error(error, error_size, "Credential for registry '%s' has invalid base64 auth", registry);
        return 0;
    }
    colon = strchr((char *)decoded, ':');
    *username_out = oras_strndup((char *)decoded, (size_t)(colon - (char *)decoded));
    *secret_out = oras_strdup(colon + 1);
    free(decoded);
    if (*username_out == NULL || *secret_out == NULL)
    {
        free(*username_out); free(*secret_out);
        oras_set_error(error, error_size, "No memory for registry credential");
        return 0;
    }
    return 1;
}

int oci_auth_login(const char *registry, const char *username, const char *secret,
                   char *error, size_t error_size)
{
    cJSON *root;
    cJSON *auths;
    cJSON *entry;
    char *plain;
    char *encoded;

    int missing;

    root = read_config(&missing, error, error_size);
    if (root == NULL)
    {
        if (!missing) return 0;
        root = cJSON_CreateObject();
        if (root == NULL) return 0;
    }
    auths = cJSON_GetObjectItemCaseSensitive(root, "auths");
    if (!cJSON_IsObject(auths)) auths = cJSON_AddObjectToObject(root, "auths");
    if (auths == NULL) { cJSON_Delete(root); return 0; }
    plain = malloc(strlen(username) + strlen(secret) + 2);
    if (plain == NULL) { cJSON_Delete(root); oras_set_error(error, error_size, "No memory for credential"); return 0; }
    sprintf(plain, "%s:%s", username, secret);
    encoded = oci_auth_base64_encode((const unsigned char *)plain, strlen(plain));
    free(plain);
    if (encoded == NULL) { cJSON_Delete(root); oras_set_error(error, error_size, "No memory for credential"); return 0; }
    entry = cJSON_CreateObject();
    if (entry == NULL)
    {
        cJSON_Delete(root);
        oras_set_error(error, error_size, "No memory for credential entry");
        return 0;
    }
    cJSON_AddStringToObject(entry, "auth", encoded);
    free(encoded);
    cJSON_DeleteItemFromObjectCaseSensitive(auths, registry);
    cJSON_AddItemToObject(auths, registry, entry);
    if (!write_config(root, error, error_size)) { cJSON_Delete(root); return 0; }
    cJSON_Delete(root);
    return 1;
}

int oci_auth_logout(const char *registry, char *error, size_t error_size)
{
    cJSON *root;
    cJSON *auths;
    int missing;

    root = read_config(&missing, error, error_size);
    if (root == NULL) return 0;
    auths = cJSON_GetObjectItemCaseSensitive(root, "auths");
    if (!cJSON_IsObject(auths) || cJSON_GetObjectItemCaseSensitive(auths, registry) == NULL)
    {
        cJSON_Delete(root);
        oras_set_error(error, error_size, "No credential entry for registry '%s'", registry);
        return 0;
    }
    cJSON_DeleteItemFromObjectCaseSensitive(auths, registry);
    if (!write_config(root, error, error_size)) { cJSON_Delete(root); return 0; }
    cJSON_Delete(root);
    return 1;
}

int oci_auth_parse_challenge(const char *text, oci_auth_challenge_t *challenge,
                             char *error, size_t error_size)
{
    const char *scan;

    memset(challenge, 0, sizeof(*challenge));
    if (strncmp(text, "Basic", 5) == 0 && (text[5] == '\0' || text[5] == ' ')) return 1;
    if (strncmp(text, "Bearer", 6) != 0 || (text[6] != '\0' && text[6] != ' '))
    {
        oras_set_error(error, error_size, "Unsupported authentication challenge"); return 0;
    }
    challenge->bearer = 1;
    scan = text + 6;
    while (*scan != '\0')
    {
        const char *key;
        const char *value;
        size_t key_length;
        size_t value_length;
        char **target;

        while (*scan == ' ' || *scan == ',') ++scan;
        key = scan; while ((*scan >= 'a' && *scan <= 'z') || (*scan >= 'A' && *scan <= 'Z')) ++scan;
        key_length = (size_t)(scan - key);
        if (*scan++ != '=' || *scan++ != '"') { oci_auth_free_challenge(challenge); oras_set_error(error,error_size,"Malformed Bearer authentication challenge"); return 0; }
        value = scan; while (*scan != '\0' && *scan != '"') ++scan;
        if (*scan != '"') { oci_auth_free_challenge(challenge); oras_set_error(error,error_size,"Malformed Bearer authentication challenge"); return 0; }
        value_length = (size_t)(scan++ - value);
        target = key_length == 5 && strncmp(key, "realm", 5) == 0 ? &challenge->realm :
                 key_length == 7 && strncmp(key, "service", 7) == 0 ? &challenge->service :
                 key_length == 5 && strncmp(key, "scope", 5) == 0 ? &challenge->scope : NULL;
        if (target != NULL) *target = oras_strndup(value, value_length);
    }
    if (challenge->realm == NULL) { oci_auth_free_challenge(challenge); oras_set_error(error,error_size,"Bearer authentication challenge is missing realm"); return 0; }
    return 1;
}

void oci_auth_free_challenge(oci_auth_challenge_t *challenge)
{
    free(challenge->realm); free(challenge->service); free(challenge->scope);
    memset(challenge, 0, sizeof(*challenge));
}

int oci_auth_parse_token(const char *json, char **token_out, char *error, size_t error_size)
{
    cJSON *root;
    cJSON *token;

    *token_out = NULL;
    root = cJSON_Parse(json);
    token = root == NULL ? NULL : cJSON_GetObjectItemCaseSensitive(root, "token");
    if (!cJSON_IsString(token)) token = root == NULL ? NULL : cJSON_GetObjectItemCaseSensitive(root, "access_token");
    if (!cJSON_IsString(token) || token->valuestring[0] == '\0')
    {
        cJSON_Delete(root); oras_set_error(error, error_size, "Token exchange returned no token"); return 0;
    }
    *token_out = oras_strdup(token->valuestring);
    cJSON_Delete(root);
    return *token_out != NULL;
}
