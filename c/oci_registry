#include <stdlib.h>
#include <string.h>
#include <stdio.h>

#include "oras_types.h"
#include "url_fetch.h"
#include "oci_registry.h"

static int ascii_tolower(int ch)
{
    if (ch >= 'A' && ch <= 'Z')
    {
        return ch + ('a' - 'A');
    }
    return ch;
}

static int equal_casefold(const char *left, const char *right)
{
    while (*left != '\0' && *right != '\0')
    {
        if (ascii_tolower((unsigned char)*left) != ascii_tolower((unsigned char)*right))
        {
            return 0;
        }
        ++left;
        ++right;
    }
    return *left == '\0' && *right == '\0';
}

static int is_docker_hub_registry(const oci_reference_t *reference)
{
    return strcmp(reference->registry, "registry-1.docker.io") == 0;
}

static int reject_unsupported_registry_auth(const oci_reference_t *reference,
                                            char *error,
                                            size_t error_size)
{
    if (is_docker_hub_registry(reference))
    {
        oras_set_error(error,
                       error_size,
                       "Docker Hub authentication is not implemented yet; "
                       "docker.io requests are not currently supported");
        return 0;
    }
    return 1;
}

static char *build_url(const oci_reference_t *reference,
                       const char *suffix)
{
    size_t length;
    char *url;
    const char *scheme;

    scheme = (strncmp(reference->registry, "localhost", 9) == 0 ||
              strncmp(reference->registry, "127.0.0.1", 9) == 0) ?
             "http" : "https";
    length = strlen(reference->registry) + strlen(reference->repository) +
             strlen(suffix) + strlen(scheme) + 8;
    url = malloc(length);
    if (url == NULL)
    {
        return NULL;
    }
    sprintf(url, "%s://%s/v2/%s%s", scheme, reference->registry, reference->repository, suffix);
    return url;
}

static const char *selector_string(const oci_reference_t *reference)
{
    return reference->digest != NULL ? reference->digest : reference->tag;
}

static const char *response_header(const url_fetch_response_t *response,
                                   const char *name)
{
    size_t i;

    for (i = 0; i < response->header_count; ++i)
    {
        if (equal_casefold(response->headers[i].name, name))
        {
            return response->headers[i].value;
        }
    }
    return NULL;
}

static int looks_like_html(const unsigned char *data, size_t size)
{
    const char *scan;
    size_t length;

    scan = (const char *)data;
    length = size;
    while (length != 0 &&
           (*scan == ' ' || *scan == '\t' || *scan == '\r' || *scan == '\n'))
    {
        ++scan;
        --length;
    }
    if (length >= 5 && strncmp(scan, "<html", 5) == 0)
    {
        return 1;
    }
    if (length >= 14 && strncmp(scan, "<!DOCTYPE html", 14) == 0)
    {
        return 1;
    }
    return 0;
}

static int validate_json_response(const url_fetch_response_t *response,
                                  const char *url,
                                  char *error,
                                  size_t error_size)
{
    const char *content_type;
    const unsigned char *body;
    size_t body_size;

    content_type = response_header(response, "Content-Type");
    body = response->body;
    body_size = response->body_size;
    if (content_type != NULL &&
        (strstr(content_type, "text/html") != NULL ||
         strstr(content_type, "application/xhtml") != NULL))
    {
        oras_set_error(error,
                       error_size,
                       "Unexpected HTML response from %s; this is not an OCI registry JSON endpoint",
                       url);
        return 0;
    }
    if (looks_like_html(body, body_size))
    {
        oras_set_error(error,
                       error_size,
                       "Unexpected HTML response from %s; this is not an OCI registry JSON endpoint",
                       url);
        return 0;
    }
    return 1;
}

static int fetch_bytes(const char *url,
                       const char *accept,
                       int expect_json,
                       unsigned char **data_out,
                       size_t *size_out,
                       char *error,
                       size_t error_size)
{
    url_fetch_header_t headers[1];
    url_fetch_request_t request;
    url_fetch_response_t response;

    memset(&request, 0, sizeof(request));
    request.url = (char *)url;
    request.method = "GET";
    if (accept != NULL)
    {
        headers[0].name = "Accept";
        headers[0].value = (char *)accept;
        request.headers = headers;
        request.header_count = 1;
    }
    if (!url_fetch_execute(&request, &response, error, error_size))
    {
        return 0;
    }
    if (response.status_code < 200 || response.status_code >= 300)
    {
        oras_set_error(error, error_size, "HTTP %d from %s", response.status_code, url);
        oras_free_response(&response);
        return 0;
    }
    if (expect_json &&
        !validate_json_response(&response, url, error, error_size))
    {
        oras_free_response(&response);
        return 0;
    }
    *data_out = response.body;
    *size_out = response.body_size;
    response.body = NULL;
    oras_free_response(&response);
    return 1;
}

static char *resolve_location(const oci_reference_t *reference,
                              const char *location)
{
    char *resolved;
    const char *scheme;

    if (strncmp(location, "http://", 7) == 0 || strncmp(location, "https://", 8) == 0)
    {
        return oras_strdup(location);
    }
    scheme = (strncmp(reference->registry, "localhost", 9) == 0 ||
              strncmp(reference->registry, "127.0.0.1", 9) == 0) ?
             "http" : "https";
    if (location[0] == '/')
    {
        resolved = malloc(strlen(reference->registry) + strlen(location) + strlen(scheme) + 4);
        if (resolved == NULL)
        {
            return NULL;
        }
        sprintf(resolved, "%s://%s%s", scheme, reference->registry, location);
        return resolved;
    }
    return build_url(reference, location);
}

int oci_registry_fetch_manifest(const oci_reference_t *reference,
                                char **json_out,
                                char *error,
                                size_t error_size)
{
    char *url;
    char suffix[1024];
    unsigned char *data;
    size_t size;

    if (!reject_unsupported_registry_auth(reference, error, error_size))
    {
        return 0;
    }
    sprintf(suffix, "/manifests/%s", selector_string(reference));
    url = build_url(reference, suffix);
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for manifest URL");
        return 0;
    }
    if (!fetch_bytes(url,
                     ORAS_MANIFEST_MEDIA_TYPE ", " ORAS_INDEX_MEDIA_TYPE ", application/vnd.docker.distribution.manifest.v2+json",
                     1,
                     &data,
                     &size,
                     error,
                     error_size))
    {
        free(url);
        return 0;
    }
    free(url);
    *json_out = oras_strndup((const char *)data, size);
    free(data);
    if (*json_out == NULL)
    {
        oras_set_error(error, error_size, "No memory for manifest text");
        return 0;
    }
    return 1;
}

int oci_registry_fetch_blob(const oci_reference_t *reference,
                            const char *digest,
                            unsigned char **data_out,
                            size_t *size_out,
                            char *error,
                            size_t error_size)
{
    char suffix[1024];
    char *url;
    int result;

    if (!reject_unsupported_registry_auth(reference, error, error_size))
    {
        return 0;
    }
    sprintf(suffix, "/blobs/%s", digest);
    url = build_url(reference, suffix);
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for blob URL");
        return 0;
    }
    result = fetch_bytes(url, NULL, 0, data_out, size_out, error, error_size);
    free(url);
    return result;
}

int oci_registry_list_tags(const oci_reference_t *reference,
                           char **json_out,
                           char *error,
                           size_t error_size)
{
    char *url;
    unsigned char *data;
    size_t size;

    if (!reject_unsupported_registry_auth(reference, error, error_size))
    {
        return 0;
