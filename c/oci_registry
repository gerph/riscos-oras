/*************************************************** Gerph *********
 Function:      ascii_tolower
 Description:   Convert an ASCII character to lower case
 Parameters:    ch = the character to convert
 Returns:       the lower-cased character, or ch unchanged if not upper case
 ******************************************************************/
static int ascii_tolower(int ch)
{
    if (ch >= 'A' && ch <= 'Z')
    {
        return ch + ('a' - 'A');
    }
    return ch;
}

/*************************************************** Gerph *********
 Function:      equal_casefold
 Description:   Compare two strings for equality, ignoring case
 Parameters:    left-> first string to compare
                right-> second string to compare
 Returns:       1 if the strings are equal, 0 if not
 ******************************************************************/
static int equal_casefold(const char *left, const char *right)
{
    while (*left != '\0' && *right != '\0')
    {
        if (ascii_tolower((unsigned char)*left) != ascii_tolower((unsigned char)*right))
        {
            return 0;
        }
        ++left;
        ++right;
    }
    return *left == '\0' && *right == '\0';
}

/*************************************************** Gerph *********
 Function:      is_docker_hub_registry
 Description:   Check whether a reference refers to the Docker Hub registry
 Parameters:    reference-> the registry reference to check
 Returns:       1 if the registry is Docker Hub, 0 if not
 ******************************************************************/
/*************************************************** Gerph *********
 Function:      build_url
 Description:   Build a v2 API URL for a repository, appending a suffix
 Parameters:    reference-> the registry/repository to build the URL for
                suffix-> the path suffix to append, eg "/tags/list"
 Returns:       pointer to a malloc'd URL string, or NULL if no memory
 ******************************************************************/
static char *build_url(const oci_reference_t *reference,
                       const char *suffix)
{
    size_t length;
    char *url;
    const char *scheme;

    /* "localhost" and "127.0.0.1" are both 9 characters, so a single
       length works for comparing against either when picking http
       for local registries and https for everything else */
    scheme = (strncmp(reference->registry, "localhost", 9) == 0 ||
              strncmp(reference->registry, "127.0.0.1", 9) == 0) ?
             "http" : "https";
    length = strlen(reference->registry) + strlen(reference->repository) +
             strlen(suffix) + strlen(scheme) + 8;
    url = malloc(length);
    if (url == NULL)
    {
        return NULL;
    }
    sprintf(url, "%s://%s/v2/%s%s", scheme, reference->registry, reference->repository, suffix);
    return url;
}

/*************************************************** Gerph *********
 Function:      selector_string
 Description:   Get the string used to select a manifest, preferring
                a digest over a tag
 Parameters:    reference-> the registry reference to select from
 Returns:       pointer to the digest, or the tag if no digest is set
 ******************************************************************/
static const char *selector_string(const oci_reference_t *reference)
{
    return reference->digest != NULL ? reference->digest : reference->tag;
}

/*************************************************** Gerph *********
 Function:      response_header
 Description:   Find a named header in a fetch response, case-insensitively
 Parameters:    response-> the response to search
                name-> the header name to look for
 Returns:       pointer to the header value, or NULL if not present
 ******************************************************************/
static const char *response_header(const url_fetch_response_t *response,
                                   const char *name)
{
    size_t i;

    for (i = 0; i < response->header_count; ++i)
    {
        if (equal_casefold(response->headers[i].name, name))
        {
            return response->headers[i].value;
        }
    }
    return NULL;
}

/*************************************************** Gerph *********
 Function:      credentials_allowed
 Description:   Check that credentials would only travel over HTTPS, except
                to the deliberate local development registry endpoints
 Parameters:    url-> request URL
 Returns:       1 if credentials may be sent, 0 otherwise
 ******************************************************************/
static int credentials_allowed(const char *url)
{
    return strncmp(url, "https://", 8) == 0 ||
           strncmp(url, "http://localhost", 16) == 0 ||
           strncmp(url, "http://127.0.0.1", 16) == 0;
}

/*************************************************** Gerph *********
 Function:      request_with_authorization
 Description:   Repeat a request with one Authorization header added
 Parameters:    request-> original request
                authorization-> complete Authorization header value
                response-> response to fill
                error-> error buffer
                error_size = error buffer size
 Returns:       1 on transport success, 0 on failure
 ******************************************************************/
static int request_with_authorization(const url_fetch_request_t *request,
                                      const char *authorization,
                                      url_fetch_response_t *response,
                                      char *error,
                                      size_t error_size)
{
    url_fetch_request_t retry;
    url_fetch_header_t *headers;
    size_t i;
    int result;

    headers = malloc((request->header_count + 1) * sizeof(*headers));
    if (headers == NULL)
    {
        oras_set_error(error, error_size, "No memory for authentication header");
        return 0;
    }
    for (i = 0; i < request->header_count; ++i) headers[i] = request->headers[i];
    headers[i].name = "Authorization";
    headers[i].value = (char *)authorization;
    retry = *request;
    retry.headers = headers;
    retry.header_count++;
    result = url_fetch_execute(&retry, response, error, error_size);
    free(headers);
    return result;
}

/*************************************************** Gerph *********
 Function:      build_basic_authorization
 Description:   Encode registry credentials as a Basic Authorization value
 Parameters:    username-> credential user name
                secret-> credential secret
 Returns:       allocated header value, or NULL
 ******************************************************************/
static char *build_basic_authorization(const char *username, const char *secret)
{
    char *plain;
    char *encoded;
    char *result;

    plain = malloc(strlen(username) + strlen(secret) + 2);
    if (plain == NULL) return NULL;
    sprintf(plain, "%s:%s", username, secret);
    encoded = oci_auth_base64_encode((const unsigned char *)plain, strlen(plain));
    free(plain);
    if (encoded == NULL) return NULL;
    result = malloc(strlen(encoded) + 7);
    if (result != NULL) sprintf(result, "Basic %s", encoded);
    free(encoded);
    return result;
}

/*************************************************** Gerph *********
 Function:      bearer_token
 Description:   Exchange stored Basic credentials for a Bearer token
 Parameters:    reference-> registry reference
                challenge-> parsed Bearer challenge
                username-> credential user name
                secret-> credential secret
                token_out-> allocated token result
                error-> error buffer
                error_size = error buffer size
 Returns:       1 on success, 0 on failure
 ******************************************************************/
static int bearer_token(const oci_reference_t *reference,
                        const oci_auth_challenge_t *challenge,
                        const char *username,
                        const char *secret,
                        char **token_out,
                        char *error,
                        size_t error_size)
{
    char *authorization;
    char *url;
    url_fetch_request_t request;
    url_fetch_response_t response;
    url_fetch_header_t header;
    char *json;
    int result;

    (void)reference;
    if (!credentials_allowed(challenge->realm))
    {
        oras_set_error(error, error_size, "Refusing to send registry credentials to non-HTTPS token realm");
        return 0;
    }
    url = malloc(strlen(challenge->realm) + (challenge->service ? strlen(challenge->service) : 0) +
                 (challenge->scope ? strlen(challenge->scope) : 0) + 24);
    if (url == NULL) { oras_set_error(error, error_size, "No memory for token URL"); return 0; }
    sprintf(url, "%s%s%s%s%s%s%s", challenge->realm,
            strchr(challenge->realm, '?') ? "&" : "?",
            challenge->service ? "service=" : "", challenge->service ? challenge->service : "",
            challenge->service && challenge->scope ? "&" : "",
            challenge->scope ? "scope=" : "", challenge->scope ? challenge->scope : "");
    authorization = build_basic_authorization(username, secret);
    if (authorization == NULL) { free(url); oras_set_error(error, error_size, "No memory for authentication header"); return 0; }
    memset(&request, 0, sizeof(request));
    header.name = "Authorization"; header.value = authorization;
    request.url = url; request.method = "GET"; request.headers = &header; request.header_count = 1;
    result = url_fetch_execute(&request, &response, error, error_size);
    free(authorization); free(url);
    if (!result) return 0;
    if (response.status_code < 200 || response.status_code >= 300)
    {
        oras_set_error(error, error_size, "Bearer token exchange failed with HTTP %d", response.status_code);
        oras_free_response(&response); return 0;
    }
    json = oras_strndup((const char *)response.body, response.body_size);
    oras_free_response(&response);
    if (json == NULL) { oras_set_error(error, error_size, "No memory for token response"); return 0; }
    result = oci_auth_parse_token(json, token_out, error, error_size);
    free(json);
    return result;
}

/*************************************************** Gerph *********
 Function:      oci_registry_request
 Description:   Execute a registry request anonymously, retrying standard
                Basic or Bearer challenges using a stored credential
 Parameters:    reference-> registry reference
                request-> request to execute
                response-> final response
                error-> error buffer
                error_size = error buffer size
 Returns:       1 on transport success, 0 on failure
 ******************************************************************/
static int oci_registry_request(const oci_reference_t *reference,
                                const url_fetch_request_t *request,
                                url_fetch_response_t *response,
                                char *error,
                                size_t error_size)
{
    const char *challenge_text;
    oci_auth_challenge_t challenge;
    char *username;
    char *secret;
    char *authorization;
    char *token;
    int result;

    authorization = NULL;
    if (!url_fetch_execute(request, response, error, error_size)) return 0;
    if (response->status_code != 401) return 1;
    challenge_text = response_header(response, "WWW-Authenticate");
    if (challenge_text == NULL)
    {
        oras_free_response(response); oras_set_error(error, error_size, "Registry returned HTTP 401 without an authentication challenge"); return 0;
    }
    if (!credentials_allowed(request->url))
    {
        oras_free_response(response); oras_set_error(error, error_size, "Refusing to send registry credentials to non-HTTPS registry"); return 0;
    }
    if (!oci_auth_parse_challenge(challenge_text, &challenge, error, error_size)) { oras_free_response(response); return 0; }
    if (!oci_auth_get_credentials(reference->registry, &username, &secret, error, error_size))
    {
        oci_auth_free_challenge(&challenge); oras_free_response(response); return 0;
    }
    oras_free_response(response);
    token = NULL;
    if (challenge.bearer)
    {
        result = bearer_token(reference, &challenge, username, secret, &token, error, error_size);
        if (result)
        {
            authorization = malloc(strlen(token) + 8);
            if (authorization != NULL) sprintf(authorization, "Bearer %s", token);
            else { oras_set_error(error, error_size, "No memory for authentication header"); result = 0; }
        }
    }
    else
    {
        authorization = build_basic_authorization(username, secret);
        result = authorization != NULL;
        if (!result) oras_set_error(error, error_size, "No memory for authentication header");
    }
    free(username); free(secret); free(token); oci_auth_free_challenge(&challenge);
    if (!result) return 0;
    result = request_with_authorization(request, authorization, response, error, error_size);
    free(authorization);
    return result;
}

/*************************************************** Gerph *********
 Function:      looks_like_html
 Description:   Check whether response body content looks like an HTML
                page rather than the expected JSON
 Parameters:    data-> the response body data
                size = length of the response body data
 Returns:       1 if the data looks like HTML, 0 if not
 ******************************************************************/
static int looks_like_html(const unsigned char *data, size_t size)
{
    const char *scan;
    size_t length;

    scan = (const char *)data;
    length = size;
    while (length != 0 &&
           (*scan == ' ' || *scan == '\t' || *scan == '\r' || *scan == '\n'))
    {
        ++scan;
        --length;
    }
    if (length >= 5 && strncmp(scan, "<html", 5) == 0)
    {
        return 1;
    }
    if (length >= 14 && strncmp(scan, "<!DOCTYPE html", 14) == 0)
    {
        return 1;
    }
    return 0;
}

/*************************************************** Gerph *********
 Function:      validate_json_response
 Description:   Check that a response looks like JSON, not an HTML
                error/login page, before it is treated as registry data
 Parameters:    response-> the response to validate
                url-> the URL the response was fetched from, for errors
                error-> buffer to receive an error message on failure
                error_size = size of the error buffer
 Returns:       1 if the response looks valid, 0 if it was rejected
 ******************************************************************/
static int validate_json_response(const url_fetch_response_t *response,
                                  const char *url,
                                  char *error,
                                  size_t error_size)
{
    const char *content_type;
    const unsigned char *body;
    size_t body_size;

    content_type = response_header(response, "Content-Type");
    body = response->body;
    body_size = response->body_size;
    /* Some registries sit behind proxies or captive portals that
       return an HTML error/login page with a 2xx status; catch that
       here rather than letting it fail obscurely in the JSON parser */
    if (content_type != NULL &&
        (strstr(content_type, "text/html") != NULL ||
         strstr(content_type, "application/xhtml") != NULL))
    {
        oras_set_error(error,
                       error_size,
                       "Unexpected HTML response from %s; this is not an OCI registry JSON endpoint",
                       url);
        return 0;
    }
    if (looks_like_html(body, body_size))
    {
        oras_set_error(error,
                       error_size,
                       "Unexpected HTML response from %s; this is not an OCI registry JSON endpoint",
                       url);
        return 0;
    }
    return 1;
}

/*************************************************** Gerph *********
 Function:      fetch_bytes
 Description:   Fetch the body of a URL, checking the HTTP status and
                optionally validating the response looks like JSON
 Parameters:    url-> the URL to fetch
                accept-> the Accept header to send, or NULL for none
                expect_json = non-zero to validate the response as JSON
                data_out-> where to store the fetched data
                size_out-> where to store the size of the fetched data
                error-> buffer to receive an error message on failure
                error_size = size of the error buffer
 Returns:       1 if successful, 0 on failure (error is filled in)
 ******************************************************************/
static int fetch_bytes(const oci_reference_t *reference,
                       const char *url,
                       const char *accept,
                       int expect_json,
                       unsigned char **data_out,
                       size_t *size_out,
                       char *error,
                       size_t error_size)
{
    url_fetch_header_t headers[1];
    url_fetch_request_t request;
    url_fetch_response_t response;

    memset(&request, 0, sizeof(request));
    request.url = (char *)url;
    request.method = "GET";
    if (accept != NULL)
    {
        headers[0].name = "Accept";
        headers[0].value = (char *)accept;
        request.headers = headers;
        request.header_count = 1;
    }
    if (!oci_registry_request(reference, &request, &response, error, error_size))
    {
        return 0;
    }
    if (response.status_code < 200 || response.status_code >= 300)
    {
        oras_set_error(error, error_size, "HTTP %d from %s", response.status_code, url);
        oras_free_response(&response);
        return 0;
    }
    if (expect_json &&
        !validate_json_response(&response, url, error, error_size))
    {
        oras_free_response(&response);
        return 0;
    }
    *data_out = response.body;
    *size_out = response.body_size;
    response.body = NULL;
    oras_free_response(&response);
    return 1;
}

/*************************************************** Gerph *********
 Function:      resolve_location
 Description:   Resolve a Location header value (from a blob upload
                start) into a full absolute URL
 Parameters:    reference-> the registry reference the location relates to
                location-> the Location header value to resolve
 Returns:       pointer to a malloc'd URL string, or NULL if no memory
 ******************************************************************/
static char *resolve_location(const oci_reference_t *reference,
                              const char *location)
{
    char *resolved;
    const char *scheme;

    if (strncmp(location, "http://", 7) == 0 || strncmp(location, "https://", 8) == 0)
    {
        return oras_strdup(location);
    }
    /* "localhost" and "127.0.0.1" are both 9 characters, so a single
       length works for comparing against either */
    scheme = (strncmp(reference->registry, "localhost", 9) == 0 ||
              strncmp(reference->registry, "127.0.0.1", 9) == 0) ?
             "http" : "https";
    if (location[0] == '/')
    {
        resolved = malloc(strlen(reference->registry) + strlen(location) + strlen(scheme) + 4);
        if (resolved == NULL)
        {
            return NULL;
        }
        sprintf(resolved, "%s://%s%s", scheme, reference->registry, location);
        return resolved;
    }
    return build_url(reference, location);
}

int oci_registry_fetch_manifest(const oci_reference_t *reference,
                                char **json_out,
                                char *error,
                                size_t error_size)
{
    char *url;
    char suffix[1024];
    unsigned char *data;
    size_t size;

    sprintf(suffix, "/manifests/%s", selector_string(reference));
    url = build_url(reference, suffix);
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for manifest URL");
        return 0;
    }
    if (!fetch_bytes(reference, url,
                     ORAS_MANIFEST_MEDIA_TYPE ", " ORAS_INDEX_MEDIA_TYPE ", application/vnd.docker.distribution.manifest.v2+json",
                     1,
                     &data,
                     &size,
                     error,
                     error_size))
    {
        free(url);
        return 0;
    }
    free(url);
    *json_out = oras_strndup((const char *)data, size);
    free(data);
    if (*json_out == NULL)
    {
        oras_set_error(error, error_size, "No memory for manifest text");
        return 0;
    }
    return 1;
}

int oci_registry_fetch_blob(const oci_reference_t *reference,
                            const char *digest,
                            unsigned char **data_out,
                            size_t *size_out,
                            char *error,
                            size_t error_size)
{
    char suffix[1024];
    char *url;
    int result;

    sprintf(suffix, "/blobs/%s", digest);
    url = build_url(reference, suffix);
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for blob URL");
        return 0;
    }
    result = fetch_bytes(reference, url, NULL, 0, data_out, size_out, error, error_size);
    free(url);
    return result;
}

int oci_registry_list_tags(const oci_reference_t *reference,
                           char **json_out,
                           char *error,
                           size_t error_size)
{
    char *url;
    unsigned char *data;
    size_t size;

    url = build_url(reference, "/tags/list");
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for tags URL");
        return 0;
    }
    if (!fetch_bytes(reference, url, "application/json", 1, &data, &size, error, error_size))
    {
        free(url);
        return 0;
    }
    free(url);
    *json_out = oras_strndup((const char *)data, size);
    free(data);
    if (*json_out == NULL)
    {
        oras_set_error(error, error_size, "No memory for tags JSON");
        return 0;
    }
    return 1;
}

int oci_registry_push_blob(const oci_reference_t *reference,
                           const unsigned char *data,
                           size_t size,
                           const char *digest,
                           char *error,
                           size_t error_size)
{
    char *url;
    url_fetch_request_t request;
    url_fetch_response_t response;
    char *location_url;
    char upload_url[2048];
    url_fetch_header_t headers[2];
    char length_text[32];
    const char *location;

    url = build_url(reference, "/blobs/uploads/");
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for upload URL");
        return 0;
    }
    memset(&request, 0, sizeof(request));
    request.url = url;
    request.method = "POST";
    if (!oci_registry_request(reference, &request, &response, error, error_size))
    {
        free(url);
        return 0;
    }
    free(url);
    if (response.status_code != 202)
    {
        oras_set_error(error, error_size, "Blob upload start failed with HTTP %d",
                       response.status_code);
        oras_free_response(&response);
        return 0;
    }
    location = response_header(&response, "Location");
    if (location == NULL)
    {
        oras_set_error(error, error_size, "Registry did not return upload location");
        oras_free_response(&response);
        return 0;
    }
    location_url = resolve_location(reference, location);
    oras_free_response(&response);
    if (location_url == NULL)
    {
        oras_set_error(error, error_size, "No memory for upload location");
        return 0;
    }
    /* The Location returned by the upload-start request may already
       carry a query string (eg a session token), so the digest must
       be appended with '&' in that case rather than always '?' */
    sprintf(upload_url, "%s%s%s%s",
            location_url,
            strchr(location_url, '?') == NULL ? "?" : "&",
            "digest=",
            digest);
    free(location_url);

    sprintf(length_text, "%u", (unsigned int)size);
    headers[0].name = "Content-Type";
    headers[0].value = ORAS_DESCRIPTOR_MEDIA_TYPE;
    headers[1].name = "Content-Length";
    headers[1].value = length_text;
    memset(&request, 0, sizeof(request));
    request.url = upload_url;
    request.method = "PUT";
    request.headers = headers;
    request.header_count = 2;
    request.body = (unsigned char *)data;
    request.body_size = size;
    if (!oci_registry_request(reference, &request, &response, error, error_size))
    {
        return 0;
    }
    if (response.status_code != 201)
    {
        oras_set_error(error, error_size, "Blob upload failed with HTTP %d",
                       response.status_code);
        oras_free_response(&response);
        return 0;
    }
    oras_free_response(&response);
    return 1;
}

int oci_registry_push_manifest(const oci_reference_t *reference,
                               const char *manifest_json,
                               char *error,
                               size_t error_size)
{
    char suffix[1024];
    char *url;
    url_fetch_request_t request;
    url_fetch_response_t response;
    url_fetch_header_t headers[2];
    char length_text[32];

    sprintf(suffix, "/manifests/%s", selector_string(reference));
    url = build_url(reference, suffix);
    if (url == NULL)
    {
        oras_set_error(error, error_size, "No memory for manifest URL");
        return 0;
    }
    sprintf(length_text, "%u", (unsigned int)strlen(manifest_json));
    headers[0].name = "Content-Type";
    headers[0].value = ORAS_MANIFEST_MEDIA_TYPE;
    headers[1].name = "Content-Length";
    headers[1].value = length_text;
    memset(&request, 0, sizeof(request));
    request.url = url;
    request.method = "PUT";
    request.headers = headers;
    request.header_count = 2;
    request.body = (unsigned char *)manifest_json;
    request.body_size = strlen(manifest_json);
    if (!oci_registry_request(reference, &request, &response, error, error_size))
    {
        free(url);
        return 0;
    }
    free(url);
    if (response.status_code < 200 || response.status_code >= 300)
    {
        oras_set_error(error, error_size, "Manifest push failed with HTTP %d",
                       response.status_code);
        oras_free_response(&response);
        return 0;
    }
    oras_free_response(&response);
    return 1;
}
