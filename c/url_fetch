/*************************************************** Gerph *********
 Function:      method_number
 Description:   Map an HTTP method name to a URL_Fetcher method number
 Parameters:    method-> the method name to look up
 Returns:       URL_Fetcher method number, or 0 if unrecognised
 ******************************************************************/
static int method_number(const char *method)
{
    if (strcmp(method, "GET") == 0)
    {
        return urlmethod_getobject;
    }
    if (strcmp(method, "HEAD") == 0)
    {
        return urlmethod_getheaders;
    }
    if (strcmp(method, "POST") == 0)
    {
        return urlmethod_post;
    }
    if (strcmp(method, "PUT") == 0)
    {
        return urlmethod_store;
    }
    if (strcmp(method, "DELETE") == 0)
    {
        return urlmethod_delete;
    }
    return 0;
}

/*************************************************** Gerph *********
 Function:      append_bytes
 Description:   Append data to a growable buffer, expanding it as needed
 Parameters:    buffer-> pointer to the buffer pointer, grown as required
                used-> pointer to the count of bytes currently used
                allocated-> pointer to the count of bytes currently allocated
                data-> the bytes to append
                length = number of bytes to append
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 if successful, 0 if failed
 ******************************************************************/
static int append_bytes(unsigned char **buffer,
                        size_t *used,
                        size_t *allocated,
                        const unsigned char *data,
                        size_t length,
                        char *error,
                        size_t error_size)
{
    unsigned char *grown;
    size_t new_allocated;

    if (*used + length > *allocated)
    {
        new_allocated = *allocated == 0 ? 4096 : *allocated * 2;
        while (new_allocated < *used + length)
        {
            new_allocated *= 2;
        }
        grown = oras_reallocarray(*buffer, new_allocated, 1);
        if (grown == NULL)
        {
            oras_set_error(error, error_size, "No memory for HTTP response");
            return 0;
        }
        *buffer = grown;
        *allocated = new_allocated;
    }
    memcpy(*buffer + *used, data, length);
    *used += length;
    return 1;
}

/*************************************************** Gerph *********
 Function:      build_request_block
 Description:   Build the combined header and body block for URL_GetURL
 Parameters:    request-> the request whose headers and body are encoded
                length_out-> where to store the length of the built block
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       pointer to the allocated block, or NULL if failed
 ******************************************************************/
static char *build_request_block(const url_fetch_request_t *request,
                                 size_t *length_out,
                                 char *error,
                                 size_t error_size)
{
    size_t i;
    size_t total;
    char *block;
    char *writer;

    total = 2;
    for (i = 0; i < request->header_count; ++i)
    {
        total += strlen(request->headers[i].name) + 2 +
                 strlen(request->headers[i].value) + 2;
    }
    total += request->body_size;
    block = malloc(total);
    if (block == NULL)
    {
        oras_set_error(error, error_size, "No memory for request headers");
        return NULL;
    }
    writer = block;
    for (i = 0; i < request->header_count; ++i)
    {
        writer += sprintf(writer, "%s: %s\r\n",
                          request->headers[i].name,
                          request->headers[i].value);
    }
    memcpy(writer, "\r\n", 2);
    writer += 2;
    if (request->body_size != 0)
    {
        memcpy(writer, request->body, request->body_size);
    }
    *length_out = total;
    return block;
}

/*************************************************** Gerph *********
 Function:      parse_response_headers
 Description:   Split a raw HTTP response into status, headers and body
 Parameters:    raw-> the raw HTTP response data
                raw_size = size of the raw response data
                response-> structure to fill in with status, headers and body
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 if successful, 0 if failed
 ******************************************************************/
static int parse_response_headers(const unsigned char *raw,
                                  size_t raw_size,
                                  url_fetch_response_t *response,
                                  char *error,
                                  size_t error_size)
{
    size_t header_end;
    const unsigned char *body;
    size_t body_size;
    char *header_copy;
    char *line;
    char *next;

    header_end = 0;
    /* Find the blank line that separates the headers from the body; accept
       either a bare LF-LF or a full CRLF-CRLF terminator */
    while (header_end + 3 < raw_size)
    {
        if ((raw[header_end] == '\r' && raw[header_end + 1] == '\n' &&
             raw[header_end + 2] == '\r' && raw[header_end + 3] == '\n') ||
            (raw[header_end] == '\n' && raw[header_end + 1] == '\n'))
        {
            break;
        }
        ++header_end;
    }
    if (header_end + 1 >= raw_size)
    {
        oras_set_error(error, error_size, "HTTP response missing header terminator");
        return 0;
    }
    /* Skip past whichever terminator was matched: 2 bytes for LF-LF, 4 for CRLF-CRLF */
    body = raw + header_end + ((raw[header_end] == '\n') ? 2 : 4);
    body_size = raw_size - (size_t)(body - raw);
    response->body = malloc(body_size == 0 ? 1 : body_size);
    if (response->body == NULL)
    {
        oras_set_error(error, error_size, "No memory for response body");
        return 0;
    }
    if (body_size != 0)
    {
        memcpy(response->body, body, body_size);
    }
    response->body_size = body_size;

    header_copy = oras_strndup((const char *)raw, body - raw);
    if (header_copy == NULL)
    {
        oras_set_error(error, error_size, "No memory for response headers");
        return 0;
    }
    line = strtok(header_copy, "\r\n");
    if (line == NULL || sscanf(line, "HTTP/%*s %d", &response->status_code) != 1)
    {
        free(header_copy);
        oras_set_error(error, error_size, "Unable to parse HTTP status line");
        return 0;
    }
    while ((next = strtok(NULL, "\r\n")) != NULL)
    {
        char *colon;

        if (next[0] == '\0')
        {
            continue;
        }
        colon = strchr(next, ':');
        if (colon == NULL)
        {
            continue;
        }
        *colon++ = '\0';
        while (*colon == ' ' || *colon == '\t')
        {
            ++colon;
        }
        if (!oras_set_annotation((oras_annotation_t **)&response->headers,
                                 &response->header_count,
                                 next,
                                 colon,
                                 error,
                                 error_size))
        {
            free(header_copy);
            return 0;
        }
    }
    free(header_copy);
    return 1;
}

int url_fetch_execute(const url_fetch_request_t *request,
                      url_fetch_response_t *response,
                      char *error,
                      size_t error_size)
{
    _kernel_oserror *oserr;
    int session;
    int flags;
    int method;
    unsigned long status;
    unsigned char chunk[4096];
    unsigned char *raw;
    size_t raw_used;
    size_t raw_allocated;
    char *request_block;
    size_t request_block_length;
    int bytes_remaining;
    int bytes_read;
    int unused_register1;
    int unused_register2;
    int unused_register3;

    memset(response, 0, sizeof(*response));
    method = method_number(request->method);
    if (method == 0)
    {
        oras_set_error(error, error_size, "Unsupported HTTP method '%s'", request->method);
        return 0;
    }
    oserr = _swix(URL_Register, _IN(0)|_OUT(1), 0, &session);
    if (oserr != NULL)
    {
        oras_set_error(error, error_size, "URL_Register failed: %s", oserr->errmess);
        return 0;
    }
    request_block = build_request_block(request, &request_block_length, error, error_size);
    if (request_block == NULL)
    {
        goto fail;
    }
    flags = request->header_count != 0 || request->body_size != 0 ? URL_GetURL_DataLengthGiven : 0;
    oserr = _swix(URL_GetURL, _INR(0, 6), flags, session, method,
                  request->url, flags != 0 ? request_block : NULL,
                  flags != 0 ? request_block_length : 2, 0);
    free(request_block);
    if (oserr != NULL)
    {
        oras_set_error(error, error_size, "URL_GetURL failed: %s", oserr->errmess);
        goto fail;
    }

    raw = NULL;
    raw_used = 0;
    raw_allocated = 0;
    status = 0;
    bytes_remaining = -1;
    /* Poll URL_ReadData until the fetch is complete and every byte has been
       drained: the module may report completion before all the data has
       actually been collected, so we must keep reading while bytes remain */
    do
    {
        oserr = _swix(URL_ReadData, _INR(0, 3)|_OUTR(0, 5),
                      0, session, chunk, sizeof(chunk), &status,
                      &unused_register1, &unused_register2, &unused_register3,
                      &bytes_read, &bytes_remaining);
        if (oserr != NULL)
        {
            oras_set_error(error, error_size, "URL_ReadData failed: %s", oserr->errmess);
            free(raw);
            goto fail;
        }
        if (bytes_read > 0)
        {
            if (!append_bytes(&raw, &raw_used, &raw_allocated,
                              chunk, (size_t)bytes_read, error, error_size))
            {
                free(raw);
                goto fail;
            }
        }
        if ((status & URL_Status_Complete) == 0 && bytes_read == 0)
        {
            /* Nothing ready yet: yield briefly so the URL_Fetcher module's
               background transport can make progress before we ask again */
            _swi(0x0000016B, _IN(0), 1);
        }
    } while ((status & URL_Status_Complete) == 0 ||
             bytes_read > 0 ||
             bytes_remaining > 0);

    _swix(URL_Deregister, _INR(0, 1), 0, session);

    if (!parse_response_headers(raw, raw_used, response, error, error_size))
    {
        free(raw);
        if (status & URL_Status_Aborted)
        {
            oras_set_error(error, error_size, "HTTP transfer aborted");
        }
        return 0;
    }
    free(raw);
    return 1;

fail:
    _swix(URL_Deregister, _INR(0, 1), 0, session);
    return 0;
}
