typedef struct test_blob_s
{
    const char *digest;
    const unsigned char *data;
    size_t size;
} test_blob_t;

static int test_failures = 0;

#define EXPECT(cond, text) \
    do { \
        if (!(cond)) \
        { \
            printf("FAIL: %s\n", text); \
            ++test_failures; \
        } \
    } while (0)

/*************************************************** Gerph *********
 Function:      test_fetch_blob
 Description:   Blob-fetch callback that serves data from an in-memory list
 Parameters:    private_ref-> array of test blobs to search
                descriptor-> descriptor whose digest is to be located
                data_out-> where to store the allocated blob data
                size_out-> where to store the blob size
                error-> buffer to receive an error message
                error_size = size of the error buffer
 Returns:       1 if found, 0 if not found or on error
 ******************************************************************/
static int test_fetch_blob(void *private_ref,
                           const oci_descriptor_t *descriptor,
                           unsigned char **data_out,
                           size_t *size_out,
                           char *error,
                           size_t error_size)
{
    const test_blob_t *blobs;
    int i;

    blobs = (const test_blob_t *)private_ref;
    for (i = 0; blobs[i].digest != NULL; ++i)
    {
        if (strcmp(blobs[i].digest, descriptor->digest) == 0)
        {
            *data_out = malloc(blobs[i].size);
            if (*data_out == NULL)
            {
                oras_set_error(error, error_size, "No memory for test blob");
                return 0;
            }
            memcpy(*data_out, blobs[i].data, blobs[i].size);
            *size_out = blobs[i].size;
            return 1;
        }
    }
    oras_set_error(error, error_size, "Missing blob %s", descriptor->digest);
    return 0;
}

