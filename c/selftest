/*************************************************** Gerph *********
 Function:      test_reference_parsing
 Description:   Exercise OCI reference string parsing
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void test_reference_parsing(void)
{
    char error[256];
    oci_reference_t reference;

    EXPECT(oci_parse_reference("registry.example.com:5000/ns/repo:tag", &reference, error, sizeof(error)),
           "parse tag reference");
    EXPECT(strcmp(reference.registry, "registry.example.com:5000") == 0, "registry with port");
    EXPECT(strcmp(reference.repository, "ns/repo") == 0, "repository path");
    EXPECT(strcmp(reference.tag, "tag") == 0, "tag");
    oras_free_reference(&reference);

    EXPECT(oci_parse_reference("registry.example.com/ns/repo@sha256:abcd", &reference, error, sizeof(error)),
           "parse digest reference");
    EXPECT(strcmp(reference.digest, "sha256:abcd") == 0, "digest selector");
    oras_free_reference(&reference);

    EXPECT(oci_parse_reference("registry.example.com/ns/repo", &reference, error, sizeof(error)),
           "default latest");
    EXPECT(strcmp(reference.tag, "latest") == 0, "default latest tag");
    oras_free_reference(&reference);
}

/*************************************************** Gerph *********
 Function:      test_metadata_annotations
 Description:   Exercise RISC OS metadata to/from annotation conversion
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void test_metadata_annotations(void)
{
    riscos_file_meta_t source;
    riscos_file_meta_t roundtrip;
    oras_annotation_t *annotations;
    size_t annotation_count;
    char error[256];

    memset(&source, 0, sizeof(source));
    annotations = NULL;
    annotation_count = 0;
    source.has_filetype = true;
    source.filetype = 0xFFF;
    source.has_loadexec = true;
    source.loadaddr = 0xFFF12345U;
    source.execaddr = 0x00112233U;
    source.has_attrs = true;
    source.attrs = 0x33U;
    EXPECT(riscos_metadata_to_annotations(&source,
                                          &annotations,
                                          &annotation_count,
                                          error,
                                          sizeof(error)),
           "metadata to annotations");
    EXPECT(riscos_metadata_from_annotations(annotations,
                                            annotation_count,
                                            &roundtrip,
                                            error,
                                            sizeof(error)),
           "annotations to metadata");
    EXPECT(roundtrip.has_filetype && roundtrip.filetype == source.filetype, "filetype roundtrip");
    EXPECT(roundtrip.has_loadexec && roundtrip.loadaddr == source.loadaddr &&
           roundtrip.execaddr == source.execaddr, "load/exec roundtrip");
    EXPECT(roundtrip.has_attrs && roundtrip.attrs == source.attrs, "attrs roundtrip");
    oras_free_annotations(annotations, annotation_count);
}

/*************************************************** Gerph *********
 Function:      test_manifest_and_paths
 Description:   Exercise fileset path sanitisation and manifest selection
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void test_manifest_and_paths(void)
{
    oci_manifest_t parsed;
    oci_descriptor_t selected;
    char error[256];
    char *safe;
    const char *index_json =
        "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.index.v1+json\","
        "\"manifests\":["
        "{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:one\",\"size\":1,"
        "\"platform\":{\"os\":\"riscos\",\"architecture\":\"arm\"}},"
        "{\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"digest\":\"sha256:two\",\"size\":1,"
        "\"platform\":{\"os\":\"linux\",\"architecture\":\"amd64\"}}]}";

    EXPECT(!riscos_fileset_sanitise_path("../bad", &safe, error, sizeof(error)),
           "reject traversal");
    EXPECT(riscos_fileset_sanitise_path("good/path", &safe, error, sizeof(error)),
           "accept nested path");
    free(safe);

    EXPECT(oci_manifest_parse(index_json, &parsed, error, sizeof(error)),
           "parse index");
    EXPECT(!oci_manifest_select(&parsed, NULL, NULL, &selected, error, sizeof(error)),
           "ambiguous index rejected");
    EXPECT(oci_manifest_select(&parsed, "riscos/arm", NULL, &selected, error, sizeof(error)),
           "platform selection");
    EXPECT(strcmp(selected.digest, "sha256:one") == 0, "selected digest");
    oras_free_descriptor(&selected);
    oras_free_manifest(&parsed);
}

/*************************************************** Gerph *********
 Function:      test_auth_helpers
 Description:   Exercise credential encodings and standard auth response parsing
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void test_auth_helpers(void)
{
    char *encoded;
    unsigned char *decoded;
    size_t size;
    char error[256];
    oci_auth_challenge_t challenge;
    char *token;

    encoded = oci_auth_base64_encode((const unsigned char *)"user:secret", 11);
    EXPECT(encoded != NULL && strcmp(encoded, "dXNlcjpzZWNyZXQ=") == 0, "credential base64 encode");
    decoded = encoded == NULL ? NULL : oci_auth_base64_decode(encoded, &size);
    EXPECT(decoded != NULL && size == 11 && memcmp(decoded, "user:secret", 11) == 0,
           "credential base64 decode");
    free(encoded);
    free(decoded);
    EXPECT(oci_auth_base64_decode("invalid!", &size) == NULL, "reject invalid base64");
    EXPECT(oci_auth_parse_challenge("Basic realm=\"test\"", &challenge, error, sizeof(error)) &&
           !challenge.bearer, "parse Basic challenge");
    oci_auth_free_challenge(&challenge);
    EXPECT(oci_auth_parse_challenge("Bearer realm=\"https://auth.example/token\", service=\"registry\", scope=\"repository:test:pull\"",
                                    &challenge, error, sizeof(error)) &&
           challenge.bearer && strcmp(challenge.service, "registry") == 0,
           "parse Bearer challenge");
    oci_auth_free_challenge(&challenge);
    EXPECT(!oci_auth_parse_challenge("Digest foo", &challenge, error, sizeof(error)),
           "reject unsupported challenge");
    EXPECT(oci_auth_parse_token("{\"access_token\":\"token-value\"}", &token, error, sizeof(error)) &&
           strcmp(token, "token-value") == 0, "parse access_token response");
    free(token);
    EXPECT(!oci_auth_parse_token("{}", &token, error, sizeof(error)), "reject tokenless response");
}

/*************************************************** Gerph *********
 Function:      test_fileset_plan_and_extract
 Description:   Exercise fileset planning, manifest building and extraction
 Parameters:    none
 Returns:       none
 ******************************************************************/
static void test_fileset_plan_and_extract(void)
{
    char error[256];
    FILE *fp;
    const char *paths[1];
    const char *duplicate_paths[2];
    riscos_fileset_entry_t *entries;
    riscos_fileset_entry_t *duplicate_entries;
    size_t entry_count;
    size_t duplicate_entry_count;
    oci_manifest_t manifest;
    const char *source_annotation;
    test_blob_t blobs[2];
    unsigned char text_data[] = "hello\n";

    ensure_dir("TestOras");
    ensure_dir("TestOras.Input");
    fp = fopen("TestOras.Input.readme,fff", "wb");
    fwrite(text_data, 1, sizeof(text_data) - 1, fp);
    fclose(fp);

    paths[0] = "TestOras.Input.readme,fff";
    EXPECT(riscos_fileset_plan(paths, 1, &entries, &entry_count, error, sizeof(error)),
           "plan fileset");
    EXPECT(entry_count == 1, "one planned file");
    EXPECT(strcmp(entries[0].relative_path, "readme,fff") == 0,
           "planned RISC OS relative path");
    EXPECT(strstr(entries[0].descriptor.media_type,
                  "application/riscos; name=\"readme,FFF\"") != NULL,
           "planned RISC OS media type with filetype");
    EXPECT(strcmp(oras_find_annotation(entries[0].descriptor.annotations,
                                       entries[0].descriptor.annotation_count,
                                       ORAS_ANNOTATION_TITLE),
                  "readme,fff") == 0,
           "planned portable title");
    EXPECT(strcmp(oras_find_annotation(entries[0].descriptor.annotations,
                                       entries[0].descriptor.annotation_count,
                                       ORAS_ANNOTATION_FILENAME),
                  "readme,fff") == 0,
           "planned native filename");
    EXPECT(entries[0].meta.has_filetype, "planned metadata filetype");

    duplicate_paths[0] = paths[0];
    duplicate_paths[1] = paths[0];
    duplicate_entries = NULL;
    duplicate_entry_count = 0;
    EXPECT(!riscos_fileset_plan(duplicate_paths,
                                2,
                                &duplicate_entries,
                                &duplicate_entry_count,
                                error,
                                sizeof(error)),
           "reject duplicate input leaf name");
    EXPECT(strcmp(error, "Duplicate input leaf name 'readme,fff'") == 0,
           "duplicate input leaf name error");

    EXPECT(riscos_fileset_manifest_from_entries(entries, entry_count,
                                                "https://github.com/example/project",
                                                &manifest, error, sizeof(error)),
           "manifest from entries");
    EXPECT(manifest.layer_count == 1, "manifest layer count");
    source_annotation = oras_find_annotation(manifest.annotations,
                                             manifest.annotation_count,
                                             ORAS_ANNOTATION_SOURCE);
    EXPECT(source_annotation != NULL &&
           strcmp(source_annotation, "https://github.com/example/project") == 0,
           "manifest source annotation");

    blobs[0].digest = manifest.layers[0].digest;
    blobs[0].data = text_data;
    blobs[0].size = sizeof(text_data) - 1;
    blobs[1].digest = NULL;
    blobs[1].data = NULL;
    blobs[1].size = 0;

    ensure_dir("TestOras.Output");
    EXPECT(riscos_fileset_extract(&manifest,
                                  "TestOras.Output",
                                  test_fetch_blob,
                                  blobs,
                                  error,
                                  sizeof(error)),
           "extract fileset");
    if (test_failures != 0)
    {
        printf("extract error: %s\n", error);
    }
    fp = fopen("TestOras.Output.readme,fff", "rb");
    EXPECT(fp != NULL, "extracted file exists");
    if (fp != NULL)
    {
        char buffer[16];
        size_t count;

        count = fread(buffer, 1, sizeof(buffer), fp);
        fclose(fp);
        EXPECT(count == sizeof(text_data) - 1, "extracted file size");
        EXPECT(memcmp(buffer, text_data, sizeof(text_data) - 1) == 0, "extracted file bytes");
    }
    /* remove() takes native RISC OS pathnames ('.' separators), unlike the
       Unix-style ('/') paths accepted by fopen() above */
    remove("TestOras.Input.readme,fff");
    remove("TestOras.Output.readme,fff");
    oras_free_manifest(&manifest);
    riscos_fileset_free_entries(entries, entry_count);
}

int oras_run_self_tests(void)
{
    test_failures = 0;
    test_reference_parsing();
    test_metadata_annotations();
    test_manifest_and_paths();
    test_auth_helpers();
    test_fileset_plan_and_extract();
    if (test_failures == 0)
    {
        printf("All self-tests passed\n");
        return 0;
    }
    printf("%d self-test(s) failed\n", test_failures);
    return 1;
}
